---
import { SITE_URL } from "../data/site";

interface Props {
  name: string;
  path: string;
}

const { name, path } = Astro.props;
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name, item: new URL(path, SITE_URL).href },
  ],
};
---

<nav aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    <li><span aria-current="page">{name}</span></li>
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

<style>
  nav { max-width: 850px; margin: auto; padding: .75rem 1.25rem; }
  ol { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; list-style: none; font-size: .9rem; }
  li { display: flex; align-items: center; gap: .5rem; }
  li + li::before { content: "/"; }
  a { display: inline-flex; align-items: center; min-height: 44px; color: inherit; }
</style>
