<script is:inline>
  // Close the site menu as soon as a link in it is tapped, or when tapping anywhere else.
  // Without this, links that jump down the same page (Reviews, Find us) leave the menu open.
  document.querySelectorAll("details.menu, details.home-menu").forEach(function (menu) {
    menu.querySelectorAll("nav a").forEach(function (link) {
      link.addEventListener("click", function () {
        menu.removeAttribute("open");
      });
    });
    document.addEventListener("click", function (event) {
      if (menu.hasAttribute("open") && !menu.contains(event.target)) menu.removeAttribute("open");
    });
  });
  // A page restored with the Back button can come back with the menu still open.
  window.addEventListener("pageshow", function () {
    document.querySelectorAll("details.menu[open], details.home-menu[open]").forEach(function (menu) {
      menu.removeAttribute("open");
    });
  });
</script>

