---
import SiteMenuBehaviour from "../../components/SiteMenuBehaviour.astro";
import { NAV_LINKS, TREATMENT_PAGES, PROVIDER, DIRECTIONS_URL, BOOKING_URL } from "../../data/site";
const path = "/treatments/waxing-fareham/";
const title = "Waxing for Women & Men in Fareham | Forever Young Beauty by Layla";
const description = "Ladies’ and men’s waxing in Fareham at Forever Young Beauty by Layla, Titchfield Common. Explore current treatments, prices and appointments online.";
const canonical = "https://foreveryoungbeautybylayla.co.uk/treatments/waxing-fareham/";
const booking = BOOKING_URL;
const schema = {"@context":"https://schema.org","@type":"Service","name":"Waxing in Fareham","description":description,"url":canonical,"provider":PROVIDER,"areaServed":[{"@type":"Place","name":"Fareham, Hampshire"},{"@type":"Place","name":"Locks Heath, Hampshire"},{"@type":"Place","name":"Park Gate, Hampshire"},{"@type":"Place","name":"Titchfield, Hampshire"},{"@type":"Place","name":"Whiteley, Hampshire"}]};
---
<!doctype html>
<html lang="en-GB">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><script type="application/ld+json" set:html={JSON.stringify(schema)} /></head>
<body>
<header class="top"><a class="brand" href="/" aria-label="Forever Young Beauty homepage"><strong>Forever Young Beauty</strong><span>by Layla</span></a><a class="corner-logo" href="/" aria-label="Return to homepage"><img src="/images/fyb-wordmark-1.png" alt="Forever Young Beauty logo" width="62" height="62" loading="eager" /></a><details class="menu"><summary aria-label="Open site menu"><span class="hamburger" aria-hidden="true">☰</span></summary><nav aria-label="Site navigation">{NAV_LINKS.map((l) => <a href={l.href} aria-current={l.href === path ? "page" : undefined}>{l.label}</a>)}</nav></details></header>
<main><section class="hero"><div class="inner"><p class="eyebrow">Forever Young Beauty by Layla · Titchfield Common</p><h1>Waxing for Women and Men in Fareham</h1><p class="lead">Professional waxing appointments for women and men in a private treatment room at Abshot Country Club, Titchfield Common, Fareham.</p><a class="button" href={booking}>View waxing prices &amp; availability</a></div></section>
<div class="content"><section><h2>Waxing treatments with Layla</h2><p>Layla offers a range of waxing services, including Hollywood, Brazilian, bikini, leg and eyebrow waxing. Check her current Treatwell menu for the precise treatments, combinations, prices and appointment times available.</p></section>
<section><h2>Men's waxing in Fareham</h2><p>Layla also offers waxing for men. The treatment areas, durations and prices can differ from the ladies' menu, so check her current <a href={booking}>Treatwell booking options</a> or contact Layla if you're unsure which appointment to select. Her treatment room at Abshot Country Club is private and welcoming.</p></section>
<section><h2>Hollywood, Brazilian and bikini waxing</h2><p>Choose the treatment that suits your preferences and comfort. If you are unsure which option to book, review the treatment descriptions in the booking widget or contact Layla before your appointment.</p></section>
<section><h2>Leg, facial and eyebrow waxing</h2><p>From leg waxing to smaller areas such as the eyebrows and upper lip, Layla's booking menu is the best place to check current options and availability.</p></section>
<section><h2>Preparing for a waxing appointment</h2><p>Allow sufficient hair growth for the wax to grip, and avoid waxing over irritated, broken or sunburnt skin. Tell Layla about relevant skin treatments, medication or sensitivities before your appointment so she can advise whether waxing is suitable.</p></section>
<section><h2>Waxing near Locks Heath, Whiteley and Park Gate</h2><p>Forever Young Beauty by Layla is based at Abshot Country Club, Little Abshot Road, Titchfield Common, Fareham PO14 4LN. The salon is convenient for clients in Titchfield Common, Locks Heath, Park Gate, Warsash, Stubbington and Whiteley. <a href={DIRECTIONS_URL}>Get directions</a>.</p></section>
<section><h2>Waxing questions</h2><h3>How much does waxing cost?</h3><p>Prices vary by treatment. The Treatwell booking widget shows Layla's current menu and prices.</p><h3>Can I book waxing online?</h3><p>Yes. Use the button below to view appointment availability and book directly through Layla's Treatwell widget.</p><h3>Where is Layla based?</h3><p>Abshot Country Club, Little Abshot Road, Titchfield Common, Fareham PO14 4LN.</p></section>
<section class="trust"><h2>Waxing treatment reviews</h2><blockquote><p>“Layla is always excellent. She is very professional, thorough and attentive, and the treatment is carried out in a calm, relaxing environment. She is also very good at putting you at ease, which makes the whole experience much more comfortable. I am a regular customer and would highly recommend her.”</p><footer>Terry · Men’s Waxing · Treatwell verified review</footer></blockquote><p><a href="https://laylaradestock.mytreatwell.co.uk/" target="_blank" rel="noopener noreferrer">See more reviews on Treatwell →</a></p></section><section class="contact"><h2>Book your waxing appointment</h2><p>View current women’s and men’s waxing options, prices and available appointments at Abshot Country Club, Little Abshot Road, Titchfield Common, Fareham PO14 4LN.</p><a class="button" href={booking}>Book waxing on Treatwell</a><p style="margin-top:.8rem;"><a href="/our-location/">How to find Layla at Abshot Country Club →</a></p></section>
<nav aria-label="Other treatments"><h2>Explore more treatments</h2><div class="links">{TREATMENT_PAGES.filter((t) => t.href !== path).map((t) => <a href={t.href}>{t.label} →</a>)}</div></nav></div></main>
<footer><a href="/">Forever Young Beauty by Layla</a> · Titchfield Common, Fareham</footer>
<SiteMenuBehaviour />
<script src="/booking-tracking.js" defer></script>
</body></html>
<style>
/* Keep primary booking actions comfortably tappable on mobile. */
a.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;text-align:center}
@media(max-width:560px){.hero a.button{max-width:100%;width:100%}.menu summary{min-width:48px;min-height:48px;justify-content:center}.menu nav a{min-height:44px;display:flex;align-items:center}}

:root{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#1b3a4c;background:#fff}*{box-sizing:border-box}body{margin:0;line-height:1.7}a{color:#1b3a4c}.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem max(1rem,calc((100vw - 1050px)/2));background:#1b3a4c;color:white}.top a{color:white;text-decoration:none}.top span{font-weight:700;text-align:center}.top em{font-family:Georgia,serif;color:#d9c79f;font-weight:400}.hero{background:linear-gradient(140deg,#1b3a4c,#31576a);color:white;padding:4.5rem 1.25rem}.inner{max-width:900px;margin:auto;text-align:center}.eyebrow{text-transform:uppercase;letter-spacing:.14em;color:#dfc99b;font-size:.78rem;font-weight:700}h1,h2{font-family:Georgia,serif;line-height:1.2}h1{font-size:clamp(2rem,5vw,3.6rem);margin:.6rem 0 1rem}.lead{font-size:1.14rem;max-width:720px;margin:0 auto 2rem;color:#edf1f3}.button{display:inline-block;background:#b09a6e;color:#172f3b;text-decoration:none;padding:.85rem 1.4rem;border-radius:99px;font-weight:700}.button:hover{background:#dfc99b}.content{max-width:850px;margin:auto;padding:2.5rem 1.25rem}.content section{margin:0 0 2.5rem}.content h2{font-size:1.7rem;margin-bottom:.65rem}.content p{margin-top:0}.content video{width:100%;max-height:520px;background:#102733;border-radius:12px}.contact{background:#eef1f3;border-radius:18px;padding:2rem;margin-top:3rem!important}.contact .button{margin:1rem 0}.links{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:.8rem}.links a{display:block;background:#eef1f3;padding:1rem;border-radius:12px;text-decoration:none;font-weight:600}footer{padding:2rem 1rem;text-align:center;background:#1b3a4c;color:white}footer a{color:white}@media(max-width:560px){.top{font-size:.78rem}.top span{max-width:150px}.hero{padding:3rem 1rem}}
.top{position:relative;display:flex;align-items:center;justify-content:center;min-height:92px;padding:12px 78px 12px 16px}.top .brand{display:flex;flex-direction:column;align-items:center;text-align:center;line-height:1.3;text-decoration:none;color:#fff;max-width:100%}.brand strong{font-size:clamp(.95rem,3.4vw,1.3rem);white-space:nowrap}.brand span{font-family:Georgia,serif;color:#d9c79f;font-size:.96rem;margin-top:3px}.menu{position:absolute;right:14px;top:50%;transform:translateY(-50%);z-index:20}.menu summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:5px;color:#fff;padding:8px}.menu summary::-webkit-details-marker{display:none}.hamburger{font-size:1.55rem;line-height:1}.menu-label{font-size:.8rem}.menu nav{position:absolute;right:0;top:calc(100% + 9px);background:#fff;border:1px solid #d7dfe3;border-radius:12px;box-shadow:0 8px 22px #10273330;min-width:210px;display:flex;flex-direction:column;padding:8px}.menu nav a{color:#1b3a4c;text-decoration:none;padding:9px 12px;border-radius:7px}.menu nav a:hover,.menu nav a:focus-visible{background:#eef1f3}@media(max-width:560px){.top{padding-right:65px}.menu-label{display:none}.menu{right:9px}.brand strong{font-size:clamp(.84rem,3.8vw,1.05rem)}}.corner-logo{position:absolute;left:14px;right:auto;top:50%;transform:translateY(-50%);width:54px;height:54px;border-radius:50%;background:#fff;display:grid;place-items:center;overflow:hidden;padding:5px;box-shadow:0 1px 5px #0002}.corner-logo img{width:100%;height:100%;object-fit:contain}.top{padding-left:85px;padding-right:75px}.menu{right:13px}@media(max-width:560px){.corner-logo{left:8px;right:auto;width:43px;height:43px;padding:4px}.top{padding-left:64px;padding-right:55px}.menu{right:6px}.top .brand{margin-left:0}}.corner-logo{width:62px;height:62px;padding:2px}.corner-logo img{object-fit:cover}@media(max-width:560px){.corner-logo{width:54px;height:54px;padding:2px}}</style>