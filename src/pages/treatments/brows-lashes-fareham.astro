---
import SiteMenuBehaviour from "../../components/SiteMenuBehaviour.astro";
import SiteNavigation from "../../components/SiteNavigation.astro";
import { TREATMENT_PAGES, PROVIDER, BOOKING_URL, WHATSAPP_URL } from "../../data/site";
const path = "/treatments/brows-lashes-fareham/";
const title = "Brows & Lashes in Fareham | Waxing & Tinting | Layla";
const description = "Explore eyebrow waxing and brow and lash tinting with Layla at Abshot Country Club, Titchfield Common near Fareham and Locks Heath. Book on Treatwell.";
const canonical = "https://foreveryoungbeautybylayla.co.uk/treatments/brows-lashes-fareham/";
const booking = BOOKING_URL;
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Eyebrow and Eyelash Treatments in Fareham",
  "description": description,
  "url": canonical,
  "provider": PROVIDER,
  "areaServed": ["Fareham, Hampshire", "Locks Heath, Hampshire", "Whiteley, Hampshire", "Titchfield, Hampshire"].map((name) => ({ "@type": "Place", name }))
};
---

<!doctype html>
<html lang="en-GB">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><script type="application/ld+json" set:html={JSON.stringify(schema)} /></head>
<body>
<header class="top"><a class="brand" href="/" aria-label="Forever Young Beauty homepage"><strong>Forever Young Beauty</strong><span>by Layla</span></a><a class="corner-logo" href="/" aria-label="Return to homepage"><img src="/images/fyb-wordmark-1.png" alt="Forever Young Beauty logo" width="62" height="62" loading="eager" /></a><details class="menu"><summary aria-label="Open site menu"><span class="hamburger" aria-hidden="true">☰</span></summary><SiteNavigation currentPath={path} /></details></header>
<main>
  <section class="hero">
    <div class="inner">
      <p class="eyebrow">Forever Young Beauty by Layla · Titchfield Common</p>
      <h1>Brows &amp; Lashes in Fareham</h1>
      <p class="lead">A little attention to your brows or lashes can make all the difference. Come and see me in my calm, private beauty treatment room at Abshot Country Club, near Fareham and Locks Heath.</p>
      <a class="button" href={booking}>Book brows &amp; lashes on Treatwell</a>
    </div>
  </section>
  <div class="content">
    <section>
      <h2>Eyebrow waxing and shaping</h2>
      <p>Looking for a tidy-up or more defined brows? Eyebrow waxing is one of the beauty treatments available with Layla. We'll discuss what you'd like, and you can check the current brow options and appointment times on Treatwell.</p>
    </section>
    <section>
      <h2>Eyebrow and eyelash tinting</h2>
      <p>Brow and lash tinting can help define the appearance of your natural brows and lashes. Ask Layla about the options available and any patch-testing or preparation requirements before booking.</p>
    </section>
    <section>
      <h2>Not sure which treatment to choose?</h2>
      <p>It's fine to ask! Whether you're booking eyebrow waxing, a tint or another brow or lash appointment, <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">send Layla a question on WhatsApp</a>. Treatwell shows the current services, suitability information, prices and available appointments.</p>
      <p>Looking for leg, bikini, Brazilian, Hollywood or other waxing instead? Visit the separate <a href="/treatments/waxing-fareham/">women's and men's waxing page</a>.</p>
    </section>
    <section>
      <h2>Brow and lash treatments near Locks Heath and Whiteley</h2>
      <p>Forever Young Beauty by Layla is based at Abshot Country Club, Little Abshot Road, Titchfield Common, Fareham PO14 4LN. There is free customer parking; <a href="/our-location/">see directions and information for your first visit</a>.</p>
    </section>
    <section>
      <h2>Brows and lashes: common questions</h2>
      <h3>Can I book eyebrow waxing online?</h3>
      <p>Yes. Choose from the current brow appointments shown on Treatwell. You can ask Layla which option might suit you before booking.</p>
      <h3>Will I need a patch test before a tint?</h3>
      <p>Tinting can involve ingredients that cause allergic reactions. Please check with Layla about patch-testing requirements, previous reactions and any relevant sensitivities before making an appointment.</p>
      <h3>Where can I see prices and availability?</h3>
      <p>All current prices and available appointments are on <a href={booking}>Layla's Treatwell booking page</a>.</p>
    </section>
    <section class="contact">
      <h2>Ready to book your brow or lash appointment?</h2>
      <p>Explore the current brow and lash treatments and appointment times on Treatwell, or ask Layla a question first.</p>
      <a class="button" href={booking}>Book on Treatwell</a>
      <p><a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">WhatsApp Layla →</a></p>
    </section>
    <nav aria-label="Other treatments">
      <h2>Explore more treatments</h2>
      <div class="links">{TREATMENT_PAGES.filter((t) => t.href !== path).map((t) => <a href={t.href}>{t.label} →</a>)}</div>
    </nav>
  </div>
</main>
<footer><a href="/">Forever Young Beauty by Layla</a> · Titchfield Common, Fareham</footer>
<SiteMenuBehaviour />
<script src="/booking-tracking.js" defer></script>
</body></html>
<style>
/* Keep primary booking actions comfortably tappable on mobile. */
a.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;text-align:center}
@media(max-width:560px){.hero a.button{max-width:100%;width:100%}.menu summary{min-width:48px;min-height:48px;justify-content:center}.menu nav a{min-height:44px;display:flex;align-items:center}}

:root{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#1b3a4c;background:#fff}*{box-sizing:border-box}body{margin:0;line-height:1.7}a{color:#1b3a4c}.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem max(1rem,calc((100vw - 1050px)/2));background:#1b3a4c;color:white}.top a{color:white;text-decoration:none}.top span{font-weight:700;text-align:center}.top em{font-family:Georgia,serif;color:#d9c79f;font-weight:400}.hero{background:linear-gradient(140deg,#1b3a4c,#31576a);color:white;padding:4.5rem 1.25rem}.inner{max-width:900px;margin:auto;text-align:center}.eyebrow{text-transform:uppercase;letter-spacing:.14em;color:#dfc99b;font-size:.78rem;font-weight:700}h1,h2{font-family:Georgia,serif;line-height:1.2}h1{font-size:clamp(2rem,5vw,3.6rem);margin:.6rem 0 1rem}.lead{font-size:1.14rem;max-width:720px;margin:0 auto 2rem;color:#edf1f3}.button{display:inline-block;background:#b09a6e;color:#172f3b;text-decoration:none;padding:.85rem 1.4rem;border-radius:99px;font-weight:700}.button:hover{background:#dfc99b}.content{max-width:850px;margin:auto;padding:2.5rem 1.25rem}.content section{margin:0 0 2.5rem}.content h2{font-size:1.7rem;margin-bottom:.65rem}.content p{margin-top:0}.content video{width:100%;max-height:520px;background:#102733;border-radius:12px}.contact{background:#eef1f3;border-radius:18px;padding:2rem;margin-top:3rem!important}.contact .button{margin:1rem 0}.links{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:.8rem}.links a{display:block;background:#eef1f3;padding:1rem;border-radius:12px;text-decoration:none;font-weight:600}footer{padding:2rem 1rem;text-align:center;background:#1b3a4c;color:white}footer a{color:white}@media(max-width:560px){.top{font-size:.78rem}.top span{max-width:150px}.hero{padding:3rem 1rem}}
.top{position:relative;display:flex;align-items:center;justify-content:center;min-height:92px;padding:12px 78px 12px 16px}.top .brand{display:flex;flex-direction:column;align-items:center;text-align:center;line-height:1.3;text-decoration:none;color:#fff;max-width:100%}.brand strong{font-size:clamp(.95rem,3.4vw,1.3rem);white-space:nowrap}.brand span{font-family:Georgia,serif;color:#d9c79f;font-size:.96rem;margin-top:3px}.menu{position:absolute;right:14px;top:50%;transform:translateY(-50%);z-index:20}.menu summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:5px;color:#fff;padding:8px}.menu summary::-webkit-details-marker{display:none}.hamburger{font-size:1.55rem;line-height:1}.menu-label{font-size:.8rem}.menu nav{position:absolute;right:0;top:calc(100% + 9px);background:#fff;border:1px solid #d7dfe3;border-radius:12px;box-shadow:0 8px 22px #10273330;min-width:210px;display:flex;flex-direction:column;padding:8px}.menu nav a{color:#1b3a4c;text-decoration:none;padding:9px 12px;border-radius:7px}.menu nav a:hover,.menu nav a:focus-visible{background:#eef1f3}@media(max-width:560px){.top{padding-right:65px}.menu-label{display:none}.menu{right:9px}.brand strong{font-size:clamp(.84rem,3.8vw,1.05rem)}}.corner-logo{position:absolute;left:14px;right:auto;top:50%;transform:translateY(-50%);width:54px;height:54px;border-radius:50%;background:#fff;display:grid;place-items:center;overflow:hidden;padding:5px;box-shadow:0 1px 5px #0002}.corner-logo img{width:100%;height:100%;object-fit:contain}.top{padding-left:85px;padding-right:75px}.menu{right:13px}@media(max-width:560px){.corner-logo{left:8px;right:auto;width:43px;height:43px;padding:4px}.top{padding-left:64px;padding-right:55px}.menu{right:6px}.top .brand{margin-left:0}}.corner-logo{width:62px;height:62px;padding:2px}.corner-logo img{object-fit:cover}@media(max-width:560px){.corner-logo{width:54px;height:54px;padding:2px}}</style>