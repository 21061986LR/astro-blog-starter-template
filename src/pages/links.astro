---
import SiteMenuBehaviour from "../components/SiteMenuBehaviour.astro";
import { NAV_LINKS, BOOKING_URL, GOOGLE_PLACE_ID } from "../data/site";
const path = "/links/";
const title = "Book & Connect | Forever Young Beauty by Layla";
const description = "Book beauty treatments with Layla on Treatwell, find her Google Business Profile and follow Forever Young Beauty by Layla on Instagram and Facebook.";
const canonical = "https://foreveryoungbeautybylayla.co.uk/links/";
const booking = BOOKING_URL;
const schema = {"@context":"https://schema.org","@type":"WebPage","name":title,"description":description,"url":canonical};
---
<!doctype html>
<html lang="en-GB">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><script type="application/ld+json" set:html={JSON.stringify(schema)} /></head>
<body>
<header class="top"><a class="brand" href="/" aria-label="Forever Young Beauty homepage"><strong>Forever Young Beauty</strong><span>by Layla</span></a><a class="corner-logo" href="/" aria-label="Return to homepage"><img src="/images/fyb-wordmark-1.png" alt="Forever Young Beauty logo" width="62" height="62" loading="eager" /></a><details class="menu"><summary aria-label="Open site menu"><span class="hamburger" aria-hidden="true">☰</span></summary><nav aria-label="Site navigation">{NAV_LINKS.map((l) => <a href={l.href} aria-current={l.href === path ? "page" : undefined}>{l.label}</a>)}</nav></details></header>
<main><section class="hero"><div class="inner"><p class="eyebrow">Forever Young Beauty by Layla · Fareham</p><h1>Book &amp; connect</h1><p class="lead">Your quick links to Layla’s appointments, reviews and social pages.</p><a class="button" href={booking}>Book now on Treatwell</a></div></section><div class="content"><section><h2>Find Layla online</h2><div class="links social-links"><a class="treatwell-link" href={booking}>Book on Treatwell →</a><a class="google-link" href="https://www.google.com/search?q=Forever+Young+Beauty+By+Layla+Abshot+Country+Club+Fareham"><span class="google-g" aria-hidden="true">G</span><span>View Layla’s Google Profile →</span></a><a class="google-link" href="https://www.google.com/maps/dir/?api=1&amp;destination=Forever%20Young%20Beauty%20By%20Layla%2C%20Abshot%20Country%20Club%2C%20Fareham%20PO14%204LN&amp;destination_place_id=ChIJv57sYEpvdEgR78z1GvYSv7Y"><span class="google-g" aria-hidden="true">G</span><span>Directions on Google Maps →</span></a><a class="instagram-link" href="https://www.instagram.com/foreveryoungbeauty_bylayla" target="_blank" rel="noopener noreferrer">Instagram →</a><a class="facebook-link" href="https://www.facebook.com/foreveryoungbeautybylayla" target="_blank" rel="noopener noreferrer">Facebook →</a></div></section><section class="contact"><h2>Ready to book?</h2><p>View Layla’s current treatments, prices and available appointments directly in her Treatwell booking widget.</p><a class="button" href={booking}>View prices &amp; availability</a></section></div></main>
<footer><a href="/">Forever Young Beauty by Layla</a> · Titchfield Common, Fareham</footer>
<SiteMenuBehaviour />
</body></html>
<style>
/* Keep primary booking actions comfortably tappable on mobile. */
a.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;text-align:center}
@media(max-width:560px){.hero a.button{max-width:100%;width:100%}.menu summary{min-width:48px;min-height:48px;justify-content:center}.menu nav a{min-height:44px;display:flex;align-items:center}}

:root{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#1b3a4c;background:#fff}*{box-sizing:border-box}body{margin:0;line-height:1.7}a{color:#1b3a4c}.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem max(1rem,calc((100vw - 1050px)/2));background:#1b3a4c;color:white}.top a{color:white;text-decoration:none}.top span{font-weight:700;text-align:center}.top em{font-family:Georgia,serif;color:#d9c79f;font-weight:400}.hero{background:linear-gradient(140deg,#1b3a4c,#31576a);color:white;padding:4.5rem 1.25rem}.inner{max-width:900px;margin:auto;text-align:center}.eyebrow{text-transform:uppercase;letter-spacing:.14em;color:#dfc99b;font-size:.78rem;font-weight:700}h1,h2{font-family:Georgia,serif;line-height:1.2}h1{font-size:clamp(2rem,5vw,3.6rem);margin:.6rem 0 1rem}.lead{font-size:1.14rem;max-width:720px;margin:0 auto 2rem;color:#edf1f3}.button{display:inline-block;background:#b09a6e;color:#172f3b;text-decoration:none;padding:.85rem 1.4rem;border-radius:99px;font-weight:700}.button:hover{background:#dfc99b}.content{max-width:850px;margin:auto;padding:2.5rem 1.25rem}.content section{margin:0 0 2.5rem}.content h2{font-size:1.7rem;margin-bottom:.65rem}.content p{margin-top:0}.content video{width:100%;max-height:520px;background:#102733;border-radius:12px}.contact{background:#eef1f3;border-radius:18px;padding:2rem;margin-top:3rem!important}.contact .button{margin:1rem 0}.links{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:.8rem}.links a{display:block;background:#eef1f3;padding:1rem;border-radius:12px;text-decoration:none;font-weight:600}footer{padding:2rem 1rem;text-align:center;background:#1b3a4c;color:white}footer a{color:white}@media(max-width:560px){.top{font-size:.78rem}.top span{max-width:150px}.hero{padding:3rem 1rem}}
.top{position:relative;display:flex;align-items:center;justify-content:center;min-height:92px;padding:12px 78px 12px 16px}.top .brand{display:flex;flex-direction:column;align-items:center;text-align:center;line-height:1.3;text-decoration:none;color:#fff;max-width:100%}.brand strong{font-size:clamp(.95rem,3.4vw,1.3rem);white-space:nowrap}.brand span{font-family:Georgia,serif;color:#d9c79f;font-size:.96rem;margin-top:3px}.menu{position:absolute;right:14px;top:50%;transform:translateY(-50%);z-index:20}.menu summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:5px;color:#fff;padding:8px}.menu summary::-webkit-details-marker{display:none}.hamburger{font-size:1.55rem;line-height:1}.menu-label{font-size:.8rem}.menu nav{position:absolute;right:0;top:calc(100% + 9px);background:#fff;border:1px solid #d7dfe3;border-radius:12px;box-shadow:0 8px 22px #10273330;min-width:210px;display:flex;flex-direction:column;padding:8px}.menu nav a{color:#1b3a4c;text-decoration:none;padding:9px 12px;border-radius:7px}.menu nav a:hover,.menu nav a:focus-visible{background:#eef1f3}@media(max-width:560px){.top{padding-right:65px}.menu-label{display:none}.menu{right:9px}.brand strong{font-size:clamp(.84rem,3.8vw,1.05rem)}}.corner-logo{position:absolute;left:14px;right:auto;top:50%;transform:translateY(-50%);width:54px;height:54px;border-radius:50%;background:#fff;display:grid;place-items:center;overflow:hidden;padding:5px;box-shadow:0 1px 5px #0002}.corner-logo img{width:100%;height:100%;object-fit:contain}.top{padding-left:85px;padding-right:75px}.menu{right:13px}@media(max-width:560px){.corner-logo{left:8px;right:auto;width:43px;height:43px;padding:4px}.top{padding-left:64px;padding-right:55px}.menu{right:6px}.top .brand{margin-left:0}}.corner-logo{width:62px;height:62px;padding:2px}.corner-logo img{object-fit:cover}@media(max-width:560px){.corner-logo{width:54px;height:54px;padding:2px}}
/* Platform colours apply only to the four links-page buttons. */
.social-links a{color:#fff;text-decoration:none;min-height:58px;display:flex;align-items:center;font-weight:700;transition:filter .15s ease,transform .15s ease}
.social-links a:hover,.social-links a:focus-visible{filter:brightness(.93);transform:translateY(-1px)}
.social-links .treatwell-link{background:#e94b35;color:#fff}
.social-links .google-link{background:#fff;color:#1b3a4c;border:1px solid #d9e0e4;box-shadow:0 2px 8px rgba(27,58,76,.07);text-shadow:none;gap:14px}.social-links .google-g{font-family:Arial,sans-serif;font-size:1.8rem;font-weight:800;line-height:1;background:conic-gradient(#4285f4 0deg 90deg,#34a853 90deg 175deg,#fbbc05 175deg 235deg,#ea4335 235deg 310deg,#4285f4 310deg);-webkit-background-clip:text;background-clip:text;color:transparent;flex:0 0 auto}
.social-links .instagram-link{background:linear-gradient(115deg,#833ab4,#c13584 35%,#e1306c 60%,#f77737 85%,#fcaf45)}
.social-links .facebook-link{background:#1877f2}
</style>