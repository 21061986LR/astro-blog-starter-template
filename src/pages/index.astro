  areaServed: [
    "Fareham",
    "Titchfield",
    "Titchfield Common",
    "Locks Heath",
    "Whiteley",
    "Park Gate",
    "Warsash",
    "Stubbington",
    "Portsmouth",
    "Southampton",
  ].map((name) => ({ "@type": "Place", name })),
  sameAs: [
    business.instagram,
    business.facebook,
    business.treatwell,
  ],
  makesOffer: treatments.map((t) => ({
    "@type": "Offer",
    itemOffered: { "@type": "Service", name: t.name, description: t.desc },
  })),
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${business.url}/`} />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="GB-HAM" />
    <meta name="geo.placename" content="Fareham" />
    <meta name="geo.position" content={`${business.lat};${business.lng}`} />

    <meta property="og:type" content="business.business" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${business.url}/`} />
    <meta property="og:image" content={`${business.url}/images/og-image.jpg`} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={business.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${business.url}/images/og-image.jpg`} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <style>
      :root {
        --navy: #1b3a4c;
        --navy-deep: #142c3a;
        --ink: #1b3a4c;
        --soft: #57606b;
        --silver: #d1d3d4;
        --gold: #b09a6e;
        --gold-dark: #94804f;
        --mist: #eef1f3;
        --line: #dce2e7;
        --paper: #fcfdfd;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        font-family: "Avenir Next", "Segoe UI", system-ui, sans-serif;
        color: var(--ink);
        background: var(--paper);
        line-height: 1.65;
      }
      h1, h2, h3 { font-family: Georgia, "Times New Roman", serif; font-weight: 500; }
      img, video { max-width: 100%; display: block; }
      a { color: var(--gold-dark); }
      .wrap { max-width: 1040px; margin: 0 auto; padding: 0 1.25rem; }
      section { padding: 3.5rem 0; }
      section + section { border-top: 1px solid var(--line); }
      .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 0.72rem;
        color: var(--gold-dark);
        margin-bottom: 0.5rem;
      }
      h2 { font-size: 1.75rem; margin-bottom: 1.25rem; }

      .hero { text-align: center; padding: 3rem 0 3.5rem; background: var(--navy); color: var(--silver); }
      .hero img.logo { width: 150px; margin: 0 auto 1.25rem; }
      .hero h1 { font-size: clamp(1.9rem, 5vw, 2.8rem); margin-bottom: 0.75rem; color: #fff; }
      .hero p.lede { max-width: 40rem; margin: 0 auto 1rem; color: var(--silver); }
      .stars { color: var(--gold); letter-spacing: 0.15em; font-size: 1.05rem; }
      .rating-line { font-size: 0.9rem; color: var(--silver); margin-bottom: 1.5rem; }
      .cta-row { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
      .btn {
        display: inline-block;
        padding: 0.8rem 1.6rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
      }
      .btn-primary { background: var(--gold); color: var(--navy-deep); }
      .btn-primary:hover { background: var(--gold-dark); color: #fff; }
      .hero .btn-ghost { border: 1.5px solid var(--silver); color: var(--silver); }
      .btn-ghost { border: 1.5px solid var(--navy); color: var(--navy); }
      .hero-img { margin: 2rem auto 0; max-width: 640px; border-radius: 14px; overflow: hidden; }

      .grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
      .card {
        background: var(--mist);
        border-radius: 14px;
        padding: 1.4rem 1.5rem;
        display: flex;
        flex-direction: column;
      }
      .card h3 { font-size: 1.12rem; margin-bottom: 0.4rem; color: var(--navy); }
      .card p { color: var(--soft); font-size: 0.93rem; flex: 1; }

      .reels { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
      .reels video { border-radius: 12px; width: 100%; }

      .reviews { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
      blockquote {
        background: #fff;
        border: 1px solid var(--line);
        border-top: 3px solid var(--gold);
        border-radius: 14px;
        padding: 1.4rem 1.5rem;
      }
      blockquote p { font-style: italic; margin-bottom: 0.9rem; }
      blockquote footer { font-size: 0.85rem; color: var(--soft); }

      .split { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
      table.hours { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
      table.hours td { padding: 0.45rem 0; border-bottom: 1px solid var(--line); }
      table.hours td:last-child { text-align: right; color: var(--soft); }
      .map-embed { border: 0; width: 100%; height: 320px; border-radius: 14px; }
      address { font-style: normal; color: var(--soft); }

      footer.site {
        background: var(--navy-deep);
        color: var(--silver);
        padding: 2.5rem 0;
        font-size: 0.88rem;
        text-align: center;
      }
      footer.site a { color: var(--gold); }
      footer.site .social { margin-bottom: 1rem; display: flex; gap: 1.25rem; justify-content: center; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }
    </style>
  </head>

  <body>
    <header class="hero">
      <div class="wrap">
        <img
          class="logo"
          src="/images/fyb-logo.png"
          alt="FYB by Layla — Forever Young Beauty logo"
          width="150"
          height="150"
        />
        <h1>Beauty &amp; Aesthetic Treatments in Fareham</h1>
        <p class="lede">
          Professional facials, massage and advanced aesthetics in a calm,
          private treatment room at Abshot Country Club, Titchfield Common —
          minutes from Locks Heath, Whiteley and Park Gate.
        </p>
        <div class="stars" aria-label="Rated 5 out of 5 stars">★★★★★</div>
        <p class="rating-line">
          Over 500 five-star reviews · Treatwell Top Rated 2024
          &amp; 2025
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={business.treatwell}>Book online</a>
          <a class="btn btn-ghost" href={`tel:${business.phone}`}
            >Call {business.phoneDisplay}</a
          >
        </div>
        <div class="hero-img">
          <img
            src="/images/layla-treatment.jpg"
            alt="Facial treatment in progress at Forever Young Beauty by Layla, Fareham"
            loading="eager"
          />
        </div>
      </div>
    </header>

    <section id="treatments">
      <div class="wrap">
        <p class="eyebrow">Treatments</p>
        <h2>Tailored treatments, from everyday beauty to advanced aesthetics</h2>
        <div class="grid">
          {
            treatments.map((t) => (
              <article class="card">
                <h3>{t.name}</h3>
                <p>{t.desc}</p>
              </article>
            ))
          }
        </div>
        <p style="margin-top:1.5rem;">
          <a class="btn btn-primary" href={business.treatwell}
            >See the full menu &amp; book on Treatwell</a
          >
        </p>
      </div>
    </section>

    <section id="fresh">
      <div class="wrap">
        <p class="eyebrow">Fresh from the treatment room</p>
        <h2>See recent results</h2>
        <div class="reels">
          <video src="/videos/reel1.mp4" controls preload="metadata" playsinline
          ></video>
          <video src="/videos/reel2.mp4" controls preload="metadata" playsinline
          ></video>
          <video src="/videos/reel3.mp4" controls preload="metadata" playsinline
          ></video>
        </div>
        <p style="margin-top:1.25rem;">
          <a href={business.instagram}>Follow @foreveryoungbeauty_bylayla on Instagram</a>
          for daily results, offers and last-minute availability.
        </p>
      </div>
    </section>

    <section id="reviews">
      <div class="wrap">
        <p class="eyebrow">What clients say</p>
        <h2>Over 500 five-star reviews</h2>
        <div class="reviews">
          {
            reviews.map((r) => (
              <blockquote>
                <p>“{r.quote}”</p>
                <footer>
                  {r.author} · {r.treatment} · {r.source}
                </footer>
              </blockquote>
            ))
          }
        </div>
        <p style="margin-top:1.25rem;">
          <a href={business.googleReviews}>Read our Google reviews</a> ·
          <a href={business.treatwell}>Read verified reviews on Treatwell</a>
        </p>
      </div>
    </section>

    <section id="find-us">
      <div class="wrap">
        <p class="eyebrow">Find us</p>
        <h2>In the heart of Titchfield Common</h2>
        <div class="split">
          <div>
            <address>
              <strong>{business.name}</strong><br />
              Beauty at Abshot, Abshot Country Club<br />
              Little Abshot Road, Titchfield Common<br />
              Fareham, Hampshire {business.postcode}
            </address>
            <p style="margin:1rem 0;">
              <a href={`tel:${business.phone}`}>{business.phoneDisplay}</a><br />
              <a href={`mailto:${business.email}`}>{business.email}</a>
            </p>
            <table class="hours" aria-label="Opening hours">
              <tr><td>Monday</td><td>11:00 – 19:30</td></tr>
              <tr><td>Tuesday</td><td>11:00 – 19:30</td></tr>
              <tr><td>Wednesday</td><td>Closed</td></tr>
              <tr><td>Thursday</td><td>11:00 – 19:30</td></tr>
              <tr><td>Friday</td><td>12:00 – 19:30</td></tr>
              <tr><td>Saturday</td><td>11:00 – 15:00</td></tr>
              <tr><td>Sunday</td><td>Closed</td></tr>
            </table>
            <p style="margin-top:1rem;">
              <a class="btn btn-ghost" href="https://maps.app.goo.gl/5pksDnVJJNuWunbZ9"
                >Get directions</a
              >
            </p>
          </div>
          <iframe
            class="map-embed"
            title="Map showing Forever Young Beauty by Layla at Abshot Country Club, Fareham"
            src="https://www.google.com/maps?q=Forever+Young+Beauty+By+Layla,+Abshot+Country+Club,+Little+Abshot+Rd,+Fareham+PO14+4LN&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>

    <footer class="site">
      <div class="wrap">
        <div class="social">
          <a href={business.instagram}>Instagram</a>
          <a href={business.facebook}>Facebook</a>
          <a href={business.treatwell}>Treatwell</a>
          <a href={business.googleReviews}>Google Reviews</a>
        </div>
        <p>
          {business.name} · Beauty at Abshot, Abshot Country Club, Little Abshot
          Road, Titchfield Common, Fareham {business.postcode}
        </p>
        <p>
          Serving Fareham, Titchfield, Locks Heath, Whiteley, Park Gate, Warsash
          &amp; Stubbington
        </p>
        <p>© 2026 {business.name}</p>
      </div>
    </footer>
  </body>
</html>
