    <style is:global>
      :root {
        --navy: #173b4c;
        --navy-dark: #0d2937;
        --cream: #f7f3ed;
        --white: #ffffff;
        --gold: #aa925f;
        --gold-light: #dfcdac;
        --text: #243a45;
        --muted: #69757b;
        --border: rgba(23, 59, 76, 0.14);
        --green: #20965a;
        --treatwell: #ff5c65;
        --facebook: #1877f2;
        --shadow: 0 16px 42px rgba(13, 41, 55, 0.13);
        --radius: 26px;
        --small-radius: 16px;
        --page-width: 1180px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 95px;
      }

      body {
        margin: 0;
        color: var(--text);
        background: var(--white);
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        line-height: 1.65;
      }

      body.menu-open {
        overflow: hidden;
      }

      img {
        display: block;
        max-width: 100%;
        height: auto;
      }

      a {
        color: inherit;
      }

      button {
        font: inherit;
      }

      h1,
      h2,
      h3 {
        margin-top: 0;
        color: var(--navy);
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 500;
        line-height: 1.08;
      }

      h1 {
        margin-bottom: 22px;
        font-size: clamp(2.6rem, 7vw, 5.6rem);
        letter-spacing: -0.045em;
      }

      h2 {
        margin-bottom: 18px;
        font-size: clamp(2.1rem, 5vw, 3.75rem);
        letter-spacing: -0.035em;
      }

      h3 {
        margin-bottom: 12px;
        font-size: 1.5rem;
      }

      p {
        margin-top: 0;
      }

      .container {
        width: min(calc(100% - 40px), var(--page-width));
        margin-inline: auto;
      }

      .section {
        padding: 88px 0;
      }

      .section-soft {
        background: var(--cream);
      }

      .section-dark {
        color: var(--white);
        background:
          radial-gradient(
            circle at top right,
            rgba(223, 205, 172, 0.16),
            transparent 38%
          ),
          var(--navy);
      }

      .section-dark h2,
      .section-dark h3 {
        color: var(--white);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 15px;
        color: var(--gold);
        font-size: 0.8rem;
        font-weight: 850;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        width: 32px;
        height: 2px;
        content: "";
        background: currentColor;
      }

      .lead {
        max-width: 760px;
        color: var(--muted);
        font-size: clamp(1.05rem, 2vw, 1.22rem);
      }

      .section-heading {
        max-width: 820px;
        margin: 0 auto 44px;
        text-align: center;
      }

      .section-heading .eyebrow {
        justify-content: center;
      }

      .section-heading .lead {
        margin-inline: auto;
      }

      .topbar {
        padding: 9px 18px;
        color: rgba(255, 255, 255, 0.93);
        background: var(--navy-dark);
        font-size: 0.84rem;
        text-align: center;
      }

      .topbar a {
        color: var(--gold-light);
        font-weight: 850;
      }

      .site-header {
        position: sticky;
        z-index: 1000;
        top: 0;
        border-bottom: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.97);
        backdrop-filter: blur(15px);
      }

      .header-inner {
        display: flex;
        min-height: 82px;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        color: var(--navy);
        text-decoration: none;
      }

      .brand img {
        width: 61px;
        height: 61px;
        object-fit: contain;
        border-radius: 50%;
      }

      .brand strong {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.16rem;
      }

      .desktop-nav {
        display: flex;
        align-items: center;
        gap: 23px;
      }

      .desktop-nav > a:not(.button) {
        color: var(--navy);
        font-size: 0.91rem;
        font-weight: 800;
        text-decoration: none;
      }

      .menu-button {
        display: none;
        width: 50px;
        height: 50px;
        place-items: center;
        padding: 0;
        color: var(--navy);
        background: var(--cream);
        border: 0;
        border-radius: 50%;
        cursor: pointer;
      }

      .menu-button svg {
        width: 25px;
        height: 25px;
      }

      .mobile-nav {
        display: none;
        padding: 8px 20px 25px;
        background: var(--white);
      }

      .mobile-nav.open {
        display: grid;
        gap: 9px;
      }

      .mobile-nav a {
        padding: 13px 16px;
        color: var(--navy);
        background: var(--cream);
        border-radius: 12px;
        font-weight: 850;
        text-decoration: none;
      }

      .button {
        display: inline-flex;
        min-height: 52px;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 14px 22px;
        border: 2px solid transparent;
        border-radius: 999px;
        font-size: 0.96rem;
        font-weight: 850;
        line-height: 1.2;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition:
          transform 180ms ease,
          box-shadow 180ms ease;
      }

      .button:hover,
      .button:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 14px 29px rgba(13, 41, 55, 0.2);
      }

      .button-primary {
        color: var(--white);
        background: var(--navy);
      }

      .button-treatwell {
        color: var(--white);
        background: var(--treatwell);
      }

      .button-whatsapp {
        color: var(--white);
        background: var(--green);
      }

      .button-light {
        color: var(--navy);
        background: var(--white);
      }

      .button-gold {
        color: var(--navy-dark);
        background: var(--gold-light);
      }

      .hero-banner-section {
        padding: 34px 0 52px;
        background: var(--cream);
      }

      .hero-banner {
        overflow: hidden;
        width: 100%;
        background: var(--navy);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .hero-banner img {
        display: block;
        width: 100%;
        height: auto;
        object-fit: contain;
      }

      .hero-content {
        padding: 64px 0 80px;
        background:
          radial-gradient(
            circle at 10% 10%,
            rgba(223, 205, 172, 0.34),
            transparent 30%
          ),
          var(--white);
      }

      .hero-grid {
        display: grid;
        align-items: center;
        gap: 54px;
        grid-template-columns: 1.04fr 0.96fr;
      }

      .hero-copy .lead {
        margin-bottom: 27px;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .hero-photo-wrap {
        position: relative;
        width: min(100%, 530px);
        margin-inline: auto;
      }

      .hero-photo-wrap::before {
        position: absolute;
        inset: 7% -5% -5% 8%;
        content: "";
        background: var(--gold-light);
        border-radius: 50%;
      }

      .hero-photo {
        position: relative;
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        border: 9px solid var(--white);
        border-radius: 50%;
        box-shadow: var(--shadow);
      }

      .booking-strip {
        margin-top: -32px;
      }

      .booking-inner {
        display: grid;
        align-items: center;
        gap: 22px;
        padding: 28px 31px;
        color: var(--white);
        background: var(--navy);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        grid-template-columns: 1fr auto;
      }

      .booking-inner h2 {
        margin-bottom: 5px;
        color: var(--white);
        font-size: clamp(1.55rem, 3vw, 2.25rem);
      }

      .booking-inner p {
        margin-bottom: 0;
        color: rgba(255, 255, 255, 0.77);
      }

      .about-grid,
      .review-feature,
      .location-grid {
        display: grid;
        align-items: center;
        gap: 56px;
        grid-template-columns: 0.9fr 1.1fr;
      }

      .about-logo,
      .review-image {
        width: min(100%, 480px);
        margin-inline: auto;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .benefits {
        display: grid;
        gap: 13px;
        margin-top: 26px;
        padding: 0;
        list-style: none;
      }

      .benefits li {
        display: flex;
        gap: 12px;
      }

      .benefits li::before {
        width: 9px;
        height: 9px;
        flex: 0 0 auto;
        margin-top: 9px;
        content: "";
        background: var(--gold);
        border-radius: 50%;
      }

      .treatment-grid {
        display: grid;
        gap: 19px;
        grid-template-columns: repeat(3, 1fr);
      }

      .treatment-card {
        display: flex;
        min-height: 100%;
        flex-direction: column;
        padding: 27px;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 20px;
        box-shadow: 0 8px 23px rgba(23, 59, 76, 0.06);
      }

      .treatment-category {
        display: inline-flex;
        align-self: flex-start;
        margin-bottom: 16px;
        padding: 7px 11px;
        color: var(--navy);
        background: var(--cream);
        border-radius: 999px;
        font-size: 0.71rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .treatment-card p {
        flex-grow: 1;
        margin-bottom: 18px;
        color: var(--muted);
        font-size: 0.93rem;
      }

      .card-link {
        color: var(--navy);
        font-size: 0.91rem;
        font-weight: 900;
        text-decoration: none;
      }

      .treatment-footer {
        margin-top: 37px;
        text-align: center;
      }

      .gallery-grid {
        display: grid;
        align-items: start;
        gap: 22px;
        grid-template-columns: repeat(2, 1fr);
      }

      .gallery-card {
        overflow: hidden;
        background: transparent;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .gallery-card img {
        display: block;
        width: 100%;
        height: auto;
        object-fit: contain;
        background: var(--cream);
      }

      .disclaimer {
        margin-top: 27px;
        padding: 18px 20px;
        color: var(--muted);
        background: var(--cream);
        border-radius: var(--small-radius);
        font-size: 0.84rem;
      }

      .review-feature-copy {
        padding: clamp(31px, 5vw, 49px);
        color: var(--white);
        background: var(--navy);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .review-feature-copy h2 {
        color: var(--white);
      }

      .review-feature-copy p {
        color: rgba(255, 255, 255, 0.8);
      }

      .reviews-grid {
        display: grid;
        gap: 22px;
        grid-template-columns: repeat(2, 1fr);
      }

      .review-card {
        padding: 35px;
        background: var(--white);
        border: 1px solid var(--border);
        border-top: 5px solid var(--gold);
        border-radius: var(--radius);
      }

      .review-card blockquote {
        margin: 0 0 24px;
        color: var(--navy);
        font-size: 1.1rem;
        font-style: italic;
        line-height: 1.75;
      }

      .review-card footer {
        color: var(--muted);
        font-size: 0.93rem;
      }

      .review-card footer strong {
        color: var(--navy);
      }

      .review-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
      }

      .social-grid {
        display: grid;
        gap: 18px;
        grid-template-columns: repeat(3, 1fr);
      }

      .social-card {
        display: grid;
        min-height: 175px;
        align-content: center;
        justify-items: center;
        gap: 9px;
        padding: 26px;
        color: var(--white);
        border-radius: var(--radius);
        text-align: center;
        text-decoration: none;
        box-shadow: var(--shadow);
      }

      .social-card strong {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.55rem;
      }

      .social-card span {
        color: rgba(255, 255, 255, 0.86);
      }

      .social-whatsapp {
        background: var(--green);
      }

      .social-instagram {
        background:
          linear-gradient(
            135deg,
            #6337be,
            #a92b88 42%,
            #dc4259 72%,
            #ed9c38
          );
      }

      .social-facebook {
        background: var(--facebook);
      }

      .location-grid {
        align-items: start;
        grid-template-columns: 1.05fr 0.95fr;
      }

      .area-list {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 25px;
      }

      .area-list span {
        padding: 9px 13px;
        color: var(--navy);
        background: var(--cream);
        border-radius: 999px;
        font-size: 0.83rem;
        font-weight: 800;
      }

      .location-card {
        padding: 32px;
        color: var(--white);
        background: var(--navy);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .location-card h3 {
        color: var(--white);
      }

      .contact-list {
        display: grid;
        gap: 15px;
        margin: 25px 0;
      }

      .contact-list a {
        color: var(--gold-light);
        font-weight: 800;
      }

      .hours-list {
        margin: 27px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.17);
      }

      .hours-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 13px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.17);
      }

      .hours-row span:last-child {
        text-align: right;
      }

      .location-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .faq-list {
        display: grid;
        max-width: 870px;
        gap: 12px;
        margin-inline: auto;
      }

      details {
        padding: 0 22px;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--small-radius);
      }

      summary {
        position: relative;
        padding: 21px 40px 21px 0;
        color: var(--navy);
        font-weight: 850;
        cursor: pointer;
        list-style: none;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      summary::after {
        position: absolute;
        top: 50%;
        right: 0;
        width: 29px;
        height: 29px;
        display: grid;
        place-items: center;
        content: "+";
        background: var(--cream);
        border-radius: 50%;
        transform: translateY(-50%);
      }

      details[open] summary::after {
        content: "−";
      }

      details p {
        padding-bottom: 20px;
        color: var(--muted);
      }

      .final-cta {
        text-align: center;
      }

      .final-cta h2 {
        max-width: 800px;
        margin-inline: auto;
      }

      .final-cta .lead {
        margin: 0 auto 26px;
        color: rgba(255, 255, 255, 0.79);
      }

      .final-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
      }

      .site-footer {
        padding: 52px 0 105px;
        color: rgba(255, 255, 255, 0.73);
        background: var(--navy-dark);
      }

      .footer-grid {
        display: grid;
        gap: 38px;
        grid-template-columns: 1.25fr 0.75fr 0.75fr;
      }

      .footer-logo {
        width: 82px;
        height: 82px;
        margin-bottom: 15px;
        object-fit: contain;
        border-radius: 50%;
      }

      .footer-heading {
        margin-bottom: 14px;
        color: var(--white);
        font-size: 0.82rem;
        font-weight: 900;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .footer-links {
        display: grid;
        gap: 8px;
      }

      .footer-links a {
        color: rgba(255, 255, 255, 0.73);
        text-decoration: none;
      }

      .copyright {
        margin-top: 38px;
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        font-size: 0.82rem;
      }

      .mobile-booking-bar {
        position: fixed;
        z-index: 1100;
        right: 0;
        bottom: 0;
        left: 0;
        display: none;
        grid-template-columns: 1fr auto;
        gap: 9px;
        padding: 10px 13px;
        background: rgba(255, 255, 255, 0.98);
        border-top: 1px solid var(--border);
        box-shadow: 0 -8px 28px rgba(23, 59, 76, 0.14);
      }

      .mobile-booking-bar .button {
        min-height: 49px;
      }

      :focus-visible {
        outline: 3px solid rgba(170, 146, 95, 0.6);
        outline-offset: 4px;
      }

      @media (max-width: 1000px) {
        .desktop-nav {
          display: none;
        }

        .menu-button {
          display: grid;
        }

        .hero-grid,
        .about-grid,
        .review-feature,
        .location-grid {
          grid-template-columns: 1fr;
        }

        .hero-copy {
          text-align: center;
        }

        .hero-copy .lead {
          margin-inline: auto;
        }

        .hero-actions {
          justify-content: center;
        }

        .treatment-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .social-grid {
          grid-template-columns: 1fr;
        }

        .footer-grid {
          grid-template-columns: 1fr 1fr;
        }

        .footer-grid > :first-child {
          grid-column: 1 / -1;
        }
      }

      @media (max-width: 700px) {
        body {
          padding-bottom: 92px;
        }

        .container {
          width: min(calc(100% - 28px), var(--page-width));
        }

        .section {
          padding: 68px 0;
        }

        .header-inner {
          min-height: 72px;
        }

        .brand img {
          width: 52px;
          height: 52px;
        }

        .brand strong {
          font-size: 1rem;
        }

        .hero-banner-section {
          padding: 18px 0 34px;
        }

        .hero-banner {
          border-radius: 17px;
        }

        .hero-content {
          padding: 51px 0 75px;
        }

        h1 {
          font-size: clamp(2.45rem, 13vw, 3.9rem);
        }

        .hero-actions {
          display: grid;
        }

        .hero-actions .button {
          width: 100%;
        }

        .booking-strip {
          margin-top: -5px;
        }

        .booking-inner {
          padding: 24px;
          grid-template-columns: 1fr;
          text-align: center;
        }

        .booking-inner .button {
          width: 100%;
        }

        .treatment-grid,
        .gallery-grid,
        .reviews-grid,
        .footer-grid {
          grid-template-columns: 1fr;
        }

        .footer-grid > :first-child {
          grid-column: auto;
        }

        .review-buttons,
        .location-actions {
          display: grid;
        }

        .review-buttons .button,
        .location-actions .button {
          width: 100%;
        }

        .mobile-booking-bar {
          display: grid;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>

  <body>
    <div class="topbar">
      Based at Abshot Country Club in Titchfield Common.
      <a
        href={links.treatwell}
        target="_blank"
        rel="noopener noreferrer"
      >
        Book online with Treatwell
      </a>
    </div>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#home">
          <img
            src="/images/fyb-logo2.png"
            alt="Forever Young Beauty by Layla logo"
            width="61"
            height="61"
          />
          <strong>Forever Young Beauty</strong>
        </a>

        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#treatments">Treatments</a>
          <a href="#results">Results</a>
          <a href="#reviews">Reviews</a>
          <a href="#location">Find us</a>

          <a
            class="button button-treatwell"
            href={links.treatwell}
            target="_blank"
            rel="noopener noreferrer"
          >
            Book on Treatwell
          </a>
        </nav>

        <button
          class="menu-button"
          id="menu-button"
          type="button"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="mobile-navigation"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M4 7h16M4 12h16M4 17h16"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>

      <nav
        class="mobile-nav"
        id="mobile-navigation"
        aria-label="Mobile navigation"
      >
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#treatments">Treatments</a>
        <a href="#results">Before and after</a>
        <a href="#reviews">Reviews</a>
        <a href="#location">Find us</a>
        <a href="#faq">FAQs</a>

        <a
          href={links.treatwell}
          target="_blank"
          rel="noopener noreferrer"
        >
          Book on Treatwell
        </a>
      </nav>
    </header>

    <main>
      <section class="hero-banner-section" id="home">
        <div class="container">
          <div class="hero-banner">
            <img
              src="/images/og-image.jpg"
              alt="Forever Young Beauty by Layla — over 500 five-star reviews"
              width="1200"
              height="630"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </section>

      <section class="hero-content">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">
              Beauty at Abshot · Titchfield Common
            </p>

            <h1>Advanced beauty, skin and wellness treatments</h1>

            <p class="lead">
              Personalised facials, advanced skin treatments, massage,
              waxing, hair restoration, body treatments and aesthetics in a
              calm, welcoming treatment room near Fareham.
            </p>

            <div class="hero-actions">
              <a
                class="button button-treatwell"
                href={links.treatwell}
                target="_blank"
                rel="noopener noreferrer"
              >
                View availability and book
              </a>

              <a
                class="button button-whatsapp"
                href={links.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
              >
                Message on WhatsApp
              </a>

