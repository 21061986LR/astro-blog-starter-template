---
const siteTitle = "Forever Young Beauty by Layla | Beauty & Aesthetic Treatments Fareham";
const siteDescription =
  "Beauty salon in Titchfield Common near Fareham offering facials, massage, waxing and aesthetic treatments. Over 560 five-star Treatwell reviews.";

const treatwellUrl = "https://www.treatwell.co.uk/place/forever-young-beauty-by-layla/";
const instagramUrl = "https://www.instagram.com/foreveryoungbeauty_bylayla";
const facebookUrl = "https://www.facebook.com/share/1EFxmM1S14/";
const googleReviewsUrl = "https://maps.app.goo.gl/JPxvA3GcFrQov9SN9";
const directionsUrl = "https://maps.app.goo.gl/5pksDnVJJNuWunbZ9";

const treatments = [
  {
    title: "CACI & Advanced Facials",
    description:
      "Lift, tone and refresh the skin with results-driven facial treatments tailored to your needs.",
    url: treatwellUrl
  },
  {
    title: "Massage Treatments",
    description:
      "Relax, reset and release tension with massage treatments designed to leave you feeling your best.",
    url: treatwellUrl
  },
  {
    title: "Dermaplaning & Skin Glow",
    description:
      "Smooth, brighten and revive dull skin with exfoliating treatments for a fresher-looking complexion.",
    url: treatwellUrl
  },
  {
    title: "Microneedling",
    description:
      "Support smoother, firmer-looking skin and a more refined texture with targeted skin treatments.",
    url: treatwellUrl
  },
  {
    title: "Waxing & Beauty Essentials",
    description:
      "Professional beauty maintenance treatments in a calm, friendly and private treatment setting.",
    url: treatwellUrl
  },
  {
    title: "Body & Contouring Treatments",
    description:
      "Targeted treatments designed to support confidence, comfort and visible improvements over time.",
    url: treatwellUrl
  }
];

const reviews = [
  {
    quote:
      "Layla is always welcoming, professional and excellent at what she does. I always leave feeling better than when I arrived.",
    name: "Treatwell client"
  },
  {
    quote:
      "A lovely relaxing experience and a fantastic treatment. Layla is friendly, knowledgeable and very reassuring.",
    name: "Treatwell client"
  },
  {
    quote:
      "Beautiful treatment room, excellent service and consistently amazing results. Highly recommended.",
    name: "Treatwell client"
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta
      name="keywords"
      content="beauty salon Fareham, facials Fareham, massage Fareham, beauty treatments Titchfield Common, aesthetics Fareham, Layla beauty"
    />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/layla-treatment.jpg" />
    <meta name="theme-color" content="#153131" />
    <link rel="icon" href="/images/Layla-logo.jpg" />
  </head>

  <body>
    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Beauty & aesthetic treatments near Fareham</p>
            <h1>Five-star beauty in Titchfield Common</h1>
            <p class="intro">
              Discover personalised beauty, facial and massage treatments from
              Layla in a calm, welcoming setting at Abshot Country Club.
            </p>

            <div class="hero-badges">
              <span>Over 560 five-star Treatwell reviews</span>
              <span>Private treatment room</span>
              <span>Book online 24/7</span>
            </div>

            <div class="hero-buttons">
              <a
                href={treatwellUrl}
                class="btn btn-primary"
                target="_blank"
                rel="noopener noreferrer"
              >
                View prices & availability
              </a>

              <a
                href={googleReviewsUrl}
                class="btn btn-secondary"
                target="_blank"
                rel="noopener noreferrer"
              >
                Read reviews
              </a>
            </div>
          </div>

          <div class="hero-media">
            <img
              src="/images/layla-treatment.jpg"
              alt="Treatment at Forever Young Beauty by Layla"
              class="hero-image"
            />
          </div>
        </div>
      </section>

      <section class="trust-strip">
        <div class="container trust-grid">
          <div class="trust-card">
            <strong>560+</strong>
            <span>verified five-star Treatwell reviews</span>
          </div>
          <div class="trust-card">
            <strong>Fareham area</strong>
            <span>based in Titchfield Common at Abshot Country Club</span>
          </div>
          <div class="trust-card">
            <strong>Popular treatments</strong>
            <span>facials, massage, skin treatments and beauty essentials</span>
          </div>
        </div>
      </section>

      <section class="about">
        <div class="container about-grid">
          <div>
            <h2>Why clients choose Layla</h2>
            <p>
              Forever Young Beauty by Layla combines a warm personal approach
              with high standards of care, helping clients feel comfortable,
              confident and looked after from the moment they arrive.
            </p>
            <p>
              Whether you are booking a relaxing massage, a results-focused
              facial or a beauty maintenance treatment, Layla offers a calm,
              private and professional experience tailored to you.
            </p>
          </div>

          <div class="about-links">
            <a
              href={instagramUrl}
              class="info-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram
            </a>
            <a
              href={facebookUrl}
              class="info-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              Facebook
            </a>
            <a
              href={directionsUrl}
              class="info-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              Get directions
            </a>
            <a
              href={treatwellUrl}
              class="info-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              Book on Treatwell
            </a>
          </div>
        </div>
      </section>

      <section class="video-section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Fresh from the treatment room</p>
            <h2>See treatments in action</h2>
            <p>
              A quick look at the kind of calm, professional experience clients
              can expect at Forever Young Beauty by Layla.
            </p>
          </div>

          <div class="video-wrap">
            <video
              controls
              playsinline
              preload="metadata"
              poster="/videos/Jet_Plasma_Highlight-poster.jpg"
            >
              <source src="/videos/Jet_Plasma_Highlight.mp4" type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>

          <div class="section-cta">
            <a
              href={treatwellUrl}
              class="btn btn-primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              View prices & availability
            </a>
          </div>
        </div>
      </section>

      <section class="treatments">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Popular treatments</p>
            <h2>Treatments clients love</h2>
            <p>
              Browse some of the most popular categories and head through to
              Treatwell to explore current prices and appointments.
            </p>
          </div>

          <div class="cards-grid">
            {treatments.map((treatment) => (
              <article class="treatment-card">
                <h3>{treatment.title}</h3>
                <p>{treatment.description}</p>
                <a
                  href={treatment.url}
                  class="btn btn-card"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View prices & availability
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="reviews">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Client love</p>
            <h2>What clients say</h2>
            <p>
              Genuine feedback is one of the strongest reasons new clients feel
              confident booking with Layla.
            </p>
          </div>

          <div class="reviews-grid">
            {reviews.map((review) => (
              <article class="review-card">
                <blockquote>“{review.quote}”</blockquote>
                <p class="review-name">{review.name}</p>
                <a
                  href={treatwellUrl}
                  class="btn btn-secondary review-btn"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View prices & availability
                </a>
              </article>
            ))}
          </div>

          <div class="section-cta">
            <a
              href={googleReviewsUrl}
              class="btn btn-secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              See more reviews
            </a>
          </div>
        </div>
      </section>

      <section class="location">
        <div class="container location-grid">
          <div>
            <p class="eyebrow">Visit</p>
            <h2>Find the salon</h2>
            <p>
              Forever Young Beauty by Layla is based at Abshot Country Club,
              Titchfield Common, near Fareham.
            </p>
            <p>
              A friendly, professional and private setting with easy online
              booking and a wide range of beauty and treatment options.
            </p>

            <div class="location-buttons">
              <a
                href={directionsUrl}
                class="btn btn-primary"
                target="_blank"
                rel="noopener noreferrer"
              >
                Get directions
              </a>
              <a
                href={treatwellUrl}
                class="btn btn-secondary"
                target="_blank"
                rel="noopener noreferrer"
              >
                Book on Treatwell
              </a>
            </div>
          </div>

          <div class="location-card">
            <h3>Quick links</h3>
            <ul>
              <li>
                <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
              </li>
              <li>
                <a href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook</a>
              </li>
              <li>
                <a href={googleReviewsUrl} target="_blank" rel="noopener noreferrer">Google reviews</a>
              </li>
              <li>
                <a href={treatwellUrl} target="_blank" rel="noopener noreferrer">Treatwell booking</a>
              </li>
            </ul>
          </div>
        </div>
      </section>
    </main>

    <a
      href={treatwellUrl}
      class="mobile-book-bar"
      target="_blank"
      rel="noopener noreferrer"
    >
      View prices & availability
    </a>

    <style>
      :root {
        --bg: #fcf8f4;
        --surface: #ffffff;
        --surface-soft: #f4ece4;
        --text: #243232;
        --muted: #5e6a6a;
        --primary: #153131;
        --primary-hover: #204949;
        --border: #e8ddd2;
        --shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
        --radius: 22px;
        --container: 1180px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        color: var(--text);
        background: var(--bg);
        line-height: 1.6;
      }

      img,
      video {
        max-width: 100%;
      }

      a {
        color: inherit;
      }

      .container {
        width: min(var(--container), calc(100% - 2rem));
        margin: 0 auto;
      }

      .eyebrow {
        margin: 0 0 0.6rem;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--primary);
      }

      h1,
      h2,
      h3 {
        margin: 0 0 1rem;
        line-height: 1.15;
      }

      h1 {
        font-size: clamp(2.1rem, 4vw, 4rem);
      }

      h2 {
        font-size: clamp(1.8rem, 3vw, 2.7rem);
      }

      h3 {
        font-size: 1.25rem;
      }

      p {
        margin: 0 0 1rem;
      }

      .intro {
        font-size: 1.1rem;
        max-width: 44rem;
      }

      .hero,
      .about,
      .video-section,
      .treatments,
      .reviews,
      .location {
        padding: 4.5rem 0;
      }

      .hero {
        padding-top: 5rem;
        background:
          radial-gradient(circle at top left, rgba(255,255,255,0.9), rgba(255,255,255,0) 40%),
          linear-gradient(180deg, #f7eee7 0%, #fcf8f4 100%);
      }

      .hero-grid,
      .about-grid,
      .location-grid {
        display: grid;
        gap: 2rem;
        align-items: center;
      }

      .hero-grid {
        grid-template-columns: 1.1fr 0.9fr;
      }

      .about-grid,
      .location-grid {
        grid-template-columns: 1fr 0.8fr;
      }

      .hero-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin: 1.5rem 0;
      }

      .hero-badges span {
        display: inline-flex;
        align-items: center;
        padding: 0.65rem 0.9rem;
        border-radius: 999px;
        background: rgba(21, 49, 49, 0.08);
        color: var(--primary);
        font-weight: 700;
        font-size: 0.92rem;
      }

      .hero-buttons,
      .location-buttons,
      .section-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
        align-items: center;
      }

      .hero-image {
        width: 100%;
        display: block;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        object-fit: cover;
        min-height: 320px;
      }

      .trust-strip {
        padding: 1.25rem 0 0;
      }

      .trust-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(3, 1fr);
      }

      .trust-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 1.2rem;
        box-shadow: var(--shadow);
      }

      .trust-card strong {
        display: block;
        font-size: 1.05rem;
        color: var(--primary);
        margin-bottom: 0.3rem;
      }

      .about-links {
        display: grid;
        gap: 0.85rem;
      }

      .info-link {
        display: block;
        padding: 1rem 1.1rem;
        border-radius: 16px;
        background: var(--surface);
        border: 1px solid var(--border);
        text-decoration: none;
        font-weight: 700;
        box-shadow: var(--shadow);
      }

      .section-heading {
        text-align: center;
        max-width: 48rem;
        margin: 0 auto 2rem;
      }

      .video-wrap {
        max-width: 430px;
        margin: 0 auto;
      }

      .video-wrap video {
        width: 100%;
        display: block;
        border-radius: 22px;
        box-shadow: var(--shadow);
        background: #000;
      }

      .section-cta {
        justify-content: center;
        margin-top: 1.4rem;
      }

      .cards-grid,
      .reviews-grid {
        display: grid;
        gap: 1.25rem;
      }

      .cards-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .reviews-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .treatment-card,
      .review-card,
      .location-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.4rem;
        box-shadow: var(--shadow);
      }

      .treatment-card p,
      .review-card blockquote {
        color: var(--muted);
      }

      .review-card blockquote {
        margin: 0 0 1rem;
        font-size: 1.02rem;
      }

      .review-name {
        font-weight: 700;
        color: var(--primary);
      }

      .review-btn {
        margin-top: 0.7rem;
      }

      .location-card ul {
        margin: 0;
        padding-left: 1.15rem;
      }

      .location-card li {
        margin-bottom: 0.7rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.95rem 1.2rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.2s ease;
        border: 1px solid transparent;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn-primary,
      .btn-card {
        background: var(--primary);
        color: #fff;
      }

      .btn-primary:hover,
      .btn-card:hover {
        background: var(--primary-hover);
      }

      .btn-secondary {
        background: transparent;
        color: var(--primary);
        border-color: var(--primary);
      }

      .btn-secondary:hover {
        background: rgba(21, 49, 49, 0.06);
      }

      .btn-card {
        margin-top: 0.4rem;
      }

      .mobile-book-bar {
        position: fixed;
        left: 12px;
        right: 12px;
        bottom: 12px;
        z-index: 999;
        display: none;
        text-align: center;
        padding: 14px 18px;
        border-radius: 999px;
        background: var(--primary);
        color: #ffffff;
        text-decoration: none;
        font-weight: 700;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
      }

      .mobile-book-bar:hover {
        background: var(--primary-hover);
      }

      @media (max-width: 980px) {
        .hero-grid,
        .about-grid,
        .location-grid,
        .cards-grid,
        .reviews-grid,
        .trust-grid {
          grid-template-columns: 1fr;
        }

        .hero {
          padding-top: 3.5rem;
        }

        .hero-copy {
          order: 2;
        }

        .hero-media {
          order: 1;
        }
      }

      @media (max-width: 768px) {
        body {
          padding-bottom: 84px;
        }

        .hero,
        .about,
        .video-section,
        .treatments,
        .reviews,
        .location {
          padding: 3.25rem 0;
        }

        .hero-buttons,
        .location-buttons,
        .section-cta {
          flex-direction: column;
          align-items: stretch;
        }

        .hero-buttons .btn,
        .location-buttons .btn,
        .section-cta .btn {
          width: 100%;
        }

        .mobile-book-bar {
          display: block;
        }
      }
    </style>
  </body>
</html>