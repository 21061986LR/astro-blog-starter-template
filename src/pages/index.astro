        color: var(--white);
        font-size: 0.82rem;
        font-weight: 900;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .footer-links {
        display: grid;
        gap: 8px;
      }

      .footer-links a {
        color: rgba(255, 255, 255, 0.73);
        text-decoration: none;
      }

      .copyright {
        margin-top: 38px;
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        font-size: 0.82rem;
      }

      .mobile-booking-bar {
        position: fixed;
        z-index: 1100;
        right: 0;
        bottom: 0;
        left: 0;
        display: none;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
        padding: 10px 13px calc(10px + env(safe-area-inset-bottom));
        background: rgba(255, 255, 255, 0.98);
        border-top: 1px solid var(--border);
        box-shadow: 0 -8px 28px rgba(23, 59, 76, 0.14);
      }

      .mobile-booking-bar .button {
        width: 100%;
        min-height: 49px;
        padding-inline: 10px;
        white-space: nowrap;
      }

      :focus-visible {
        outline: 3px solid rgba(170, 146, 95, 0.6);
        outline-offset: 4px;
      }

      @media (max-width: 1000px) {
        .desktop-nav {
          display: none;
        }

        .menu-button {
          display: grid;
        }

        .hero-grid,
        .about-grid,
        .review-feature,
        .location-grid {
          grid-template-columns: 1fr;
        }

        /*
          The 54px column gap becomes a row gap once these collapse to one
          column, leaving a large blank band between the hero copy and the
          photograph. Much tighter is right when stacked.
        */
        .hero-grid {
          gap: 24px;
        }

        /*
          Capping the photograph's width is what actually gets it on screen. At
          full container width it renders around 330px tall on a phone, so the
          bottom half sits below the fold. Smaller means the whole image is
          visible, which reads better than a large partial one.
        */
        .hero-photo-wrap {
          max-width: 250px;
        }

        .hero-copy {
          text-align: center;
        }

        .hero-copy .lead {
          margin-inline: auto;
        }

        .hero-actions {
          justify-content: center;
        }

        .treatment-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        /*
          Stacked full-width blocks at 175px tall took up most of a phone
          screen for three links. As compact left-aligned bars they read as
          navigation rather than billboards, and the whole set fits in view.
        */
        .social-grid {
          gap: 10px;
          grid-template-columns: 1fr;
        }

        .social-card {
          min-height: 0;
          justify-items: start;
          gap: 2px;
          padding: 13px 18px;
          text-align: left;
        }

        .social-card strong {
          font-size: 1.05rem;
        }

        .social-card span {
          font-size: 0.82rem;
        }

        .footer-grid {
          grid-template-columns: 1fr 1fr;
        }

        .footer-grid > :first-child {
          grid-column: 1 / -1;
        }
      }

      @media (max-width: 700px) {
        body {
          padding-bottom: 92px;
        }

        /*
          The topbar is hidden here, not removed. Between the sticky top block
          and the fixed booking bar, a phone was giving up too much of the
          viewport to permanent furniture. Nothing is lost: the address appears
          again in Find Us and in the footer, and the booking link is already
          the primary button in the bar at the bottom.
        */
        .topbar {
          display: none;
        }

        /*
          Anchor offset drops to match — only the header sticks at this width,
          so the 175px used on desktop would leave a large gap above each
          section when jumping from the menu.
        */
        html {
          scroll-padding-top: 88px;
        }

        /*
          One-and-a-bit slides visible on a phone. The peek of the next slide
          is the cue that the row scrolls — without it people often don't
          realise there's more than one.
        */
        .carousel-slide {
          flex-basis: 78%;
        }

        .carousel-arrow {
          display: none !important;
        }

        .container {
          width: min(calc(100% - 28px), var(--page-width));
        }

        .section {
          padding: 68px 0;
        }

        .header-inner {
          min-height: 72px;
        }

        .brand img {
          width: 52px;
          height: 52px;
        }

        .brand strong {
          font-size: 1rem;
        }

        .hero-banner-section {
          padding: 18px 0 34px;
        }

        .hero-banner {
          border-radius: 17px;
        }

        .hero-content {
          padding: 20px 0 56px;
        }

        /*
          13vw made the headline enormous on a phone — five lines, filling the
          screen on its own and pushing the lead copy and buttons out of sight.
          11vw keeps it dominant but leaves room for the sentence underneath,
          which is what actually tells someone what the business does.
        */
        /*
          Headline sized to fit three lines rather than four or five. Every line
          it loses is roughly 50px of Layla's photograph brought above the fold,
          and the photograph does more selling than a fourth line of type.
        */
        h1 {
          margin-bottom: 14px;
          font-size: clamp(1.85rem, 8.6vw, 2.8rem);
        }

        .hero-actions {
          display: grid;
        }

        .hero-actions .button {
          width: 100%;
        }

        .booking-strip {
          margin-top: -5px;
        }

        .booking-inner {
          padding: 24px;
          grid-template-columns: 1fr;
          text-align: center;
        }

        .booking-inner .button {
          width: 100%;
        }

        .treatment-grid,
        .gallery-grid,
        .reviews-grid,
        .footer-grid {
          grid-template-columns: 1fr;
        }

        .footer-grid > :first-child {
          grid-column: auto;
        }

        .review-buttons,
        .location-actions {
          display: grid;
        }

        .review-buttons .button,
        .location-actions .button {
          width: 100%;
        }

        .mobile-booking-bar {
          display: grid;
        }
      }


      /* Opening sequence: round FYB logo, then fade away. */
      .opening-loader {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: grid;
        place-items: center;
        min-height: 100vh;
        min-height: 100svh;
        padding: 18px;
        overflow: hidden;
        background: #ffffff;
        opacity: 1;
        visibility: visible;
        transition: opacity 0.6s ease, visibility 0.6s ease;
      }

      .opening-loader.is-leaving {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .opening-logo img {
        display: block;
        width: min(88vw, 510px);
        height: auto;
        border-radius: 50%;
        animation: logo-settle 0.7s ease both;
      }

      @keyframes logo-settle {
        from {
          opacity: 0;
          transform: scale(0.94);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      body.loader-active {
        overflow: hidden;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
        }

        .opening-logo img {
          animation: none;
        }
      }
    </style>
  </head>

