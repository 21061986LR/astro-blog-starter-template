        border-bottom: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(16px);
      }

      .header-inner {
        display: flex;
        min-height: 82px;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 13px;
        color: var(--navy);
        text-decoration: none;
      }

      .brand img {
        width: 59px;
        height: 59px;
        object-fit: contain;
        border-radius: 50%;
      }

      .brand-copy {
        display: grid;
        line-height: 1.15;
      }

      .brand-copy strong {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.06rem;
      }

      .brand-copy span {
        margin-top: 4px;
        color: var(--muted);
        font-size: 0.69rem;
        font-weight: 750;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .desktop-nav {
        display: flex;
        align-items: center;
        gap: 24px;
      }

      .desktop-nav > a:not(.button) {
        color: var(--navy);
        font-size: 0.91rem;
        font-weight: 800;
        text-decoration: none;
      }

      .desktop-nav > a:not(.button):hover {
        color: var(--gold);
      }

      .menu-button {
        display: none;
        width: 48px;
        height: 48px;
        place-items: center;
        padding: 0;
        color: var(--navy);
        background: var(--cream);
        border: 0;
        border-radius: 50%;
        cursor: pointer;
      }

      .menu-button svg {
        width: 24px;
        height: 24px;
      }

      .mobile-nav {
        display: none;
        padding: 8px 20px 24px;
        background: var(--white);
      }

      .mobile-nav.open {
        display: grid;
        gap: 9px;
      }

      .mobile-nav a {
        padding: 13px 16px;
        color: var(--navy);
        background: var(--cream);
        border-radius: 12px;
        font-weight: 800;
        text-decoration: none;
      }

      .button {
        display: inline-flex;
        min-height: 52px;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 22px;
        border: 2px solid transparent;
        border-radius: 999px;
        font-size: 0.95rem;
        font-weight: 850;
        line-height: 1.15;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition:
          transform 180ms ease,
          box-shadow 180ms ease;
      }

      .button:hover,
      .button:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 14px 30px rgba(13, 41, 55, 0.2);
      }

      .button-primary {
        color: var(--white);
        background: var(--navy);
      }

      .button-treatwell {
        color: var(--white);
        background: var(--treatwell);
      }

      .button-gold {
        color: var(--navy-dark);
        background: var(--gold-light);
      }

      .button-light {
        color: var(--navy);
        background: var(--white);
      }

      .button-whatsapp {
        color: var(--white);
        background: var(--green);
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 72px 0 88px;
        background:
          radial-gradient(
            circle at 12% 12%,
            rgba(222, 203, 168, 0.32),
            transparent 28%
          ),
          linear-gradient(135deg, var(--cream), var(--white) 66%);
      }

      .hero-grid {
        position: relative;
        z-index: 1;
        display: grid;
        align-items: center;
        gap: 58px;
        grid-template-columns: 1.04fr 0.96fr;
      }

      .hero-copy .lead {
        margin-bottom: 28px;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 27px;
      }

      .hero-points {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 20px;
        color: var(--navy);
        font-size: 0.9rem;
        font-weight: 780;
      }

      .hero-points span {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .hero-points span::before {
        width: 8px;
        height: 8px;
        content: "";
        background: var(--gold);
        border-radius: 50%;
      }

      .hero-image-wrap {
        position: relative;
        width: min(100%, 550px);
        margin-inline: auto;
      }

      .hero-image-wrap::before {
        position: absolute;
        inset: 7% -5% -5% 8%;
        content: "";
        background: var(--gold-light);
        border-radius: 50%;
      }

      .hero-image {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border: 9px solid var(--white);
        border-radius: 50%;
        box-shadow: var(--shadow);
      }

      .hero-card {
        position: absolute;
        right: -12px;
        bottom: -18px;
        max-width: 250px;
        padding: 18px 20px;
        color: var(--navy);
        background: rgba(255, 255, 255, 0.98);
        border-radius: var(--small-radius);
        box-shadow: var(--shadow);
      }

      .hero-card strong {
        display: block;
        margin-bottom: 4px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.17rem;
      }

      .hero-card span {
        color: var(--muted);
        font-size: 0.82rem;
      }

      .booking-strip {
        position: relative;
        z-index: 5;
        margin-top: -35px;
      }

      .booking-strip-inner {
        display: grid;
        align-items: center;
        gap: 24px;
        padding: 28px 31px;
        color: var(--white);
        background: var(--navy);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        grid-template-columns: 1fr auto;
      }

      .booking-strip h2 {
        margin: 0 0 5px;
        color: var(--white);
        font-size: clamp(1.55rem, 3vw, 2.25rem);
      }

      .booking-strip p {
        margin: 0;
        color: rgba(255, 255, 255, 0.75);
      }

      .about-grid,
      .review-feature,
      .location-grid {
        display: grid;
        align-items: center;
        gap: 58px;
        grid-template-columns: 0.9fr 1.1fr;
      }

      .about-logo,
      .review-image {
        width: min(100%, 490px);
        margin-inline: auto;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .benefits {
        display: grid;
        gap: 13px;
        margin-top: 27px;
        padding: 0;
        list-style: none;
      }

      .benefits li {
        display: flex;
        gap: 12px;
        align-items: flex-start;
      }

      .benefits li::before {
        width: 9px;
        height: 9px;
        flex: 0 0 auto;
        margin-top: 9px;
        content: "";
        background: var(--gold);
        border-radius: 50%;
      }

      .treatment-grid {
        display: grid;
        gap: 18px;
        grid-template-columns: repeat(3, 1fr);
      }

      .treatment-card {
        display: flex;
        min-height: 100%;
        flex-direction: column;
        padding: 26px;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 19px;
        box-shadow: 0 8px 24px rgba(23, 59, 76, 0.06);
      }

      .treatment-category {
        display: inline-flex;
        align-self: flex-start;
        margin-bottom: 15px;
        padding: 6px 10px;
        color: var(--navy);
        background: var(--cream);
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .treatment-card p {
        flex-grow: 1;
        margin-bottom: 18px;
        color: var(--muted);
        font-size: 0.92rem;
      }

      .card-link {
        color: var(--navy);
        font-size: 0.9rem;
        font-weight: 900;
        text-decoration: none;
      }

      .card-link:hover {
        color: var(--gold);
      }

      .treatment-footer {
        margin-top: 36px;
        text-align: center;
      }

      .gallery-grid {
        display: grid;
        align-items: start;
        gap: 22px;
        grid-template-columns: repeat(2, 1fr);
      }

      .gallery-card {
        overflow: hidden;
        background: var(--white);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .gallery-card img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
      }

      .gallery-card.portrait img {
        aspect-ratio: 4 / 5;
      }

      .gallery-copy {
        padding: 22px;
      }

      .gallery-copy p {
        margin-bottom: 0;
        color: var(--muted);
        font-size: 0.9rem;
      }

      .gallery-disclaimer {
        margin-top: 27px;
        padding: 18px 20px;
        color: var(--muted);
        background: var(--cream);
        border-radius: var(--small-radius);
        font-size: 0.83rem;
      }

      .review-feature-copy {
        padding: clamp(30px, 5vw, 50px);
        color: var(--white);
        background: var(--navy);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .review-feature-copy h2 {
        color: var(--white);
      }

      .review-feature-copy p {
        color: rgba(255, 255, 255, 0.8);
      }

      .reviews-grid {
        display: grid;
        gap: 22px;
        grid-template-columns: repeat(2, 1fr);
      }

      .review-card {
        padding: 35px;
        background: var(--white);
        border: 1px solid var(--border);
        border-top: 5px solid var(--gold);
        border-radius: var(--radius);
      }

      .review-card blockquote {
        margin: 0 0 24px;
        color: var(--navy);
        font-size: 1.11rem;
        font-style: italic;
        line-height: 1.75;
      }

      .review-card footer {
        color: var(--muted);
        font-size: 0.93rem;
      }

      .review-card footer strong {
        color: var(--navy);
      }

      .review-links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
      }

      .text-link {
        color: var(--gold);
        font-weight: 850;
        text-underline-offset: 4px;
      }

      .social-grid {
        display: grid;
        gap: 18px;
        grid-template-columns: repeat(3, 1fr);
      }

      .social-card {
        display: grid;
        min-height: 175px;
        align-content: center;
        justify-items: center;
        gap: 10px;
        padding: 26px;
        color: var(--white);
        border-radius: var(--radius);
        text-align: center;
        text-decoration: none;
        box-shadow: var(--shadow);
      }

      .social-card svg {
        width: 34px;
        height: 34px;
      }

      .social-card strong {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.55rem;
      }

      .social-card span {
        color: rgba(255, 255, 255, 0.84);
        font-size: 0.9rem;
      }

      .social-whatsapp {
        background: var(--green);
      }

      .social-instagram {
        background:
          linear-gradient(135deg, #6337be, #a92b88 42%, #dc4259 72%, #ed9c38);
      }

      .social-facebook {
        background: var(--facebook);
      }

      .location-grid {
        align-items: start;
        grid-template-columns: 1.05fr 0.95fr;
      }

      .area-list {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 25px;
      }

      .area-list span {
        padding: 9px 13px;
        color: var(--navy);
        background: var(--cream);
        border-radius: 999px;
        font-size: 0.83rem;
        font-weight: 800;
      }

      .location-card {
        padding: 32px;
        color: var(--white);
        background: var(--navy);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .location-card h3 {
        color: var(--white);
      }

      .location-card p {
        color: rgba(255, 255, 255, 0.8);
      }

      .contact-list {
        display: grid;
        gap: 18px;
        margin: 25px 0;
      }

      .contact-item {
        color: rgba(255, 255, 255, 0.86);
        text-decoration: none;
      }

      .contact-item strong {
        display: block;
        color: var(--white);
      }

      .hours-list {
        margin: 28px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.16);
      }

      .hours-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 13px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.16);
      }

      .hours-row span:last-child {
        text-align: right;
      }

      .location-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .faq-list {
        display: grid;
        max-width: 870px;
        gap: 12px;
        margin-inline: auto;
      }

      details {
        padding: 0 22px;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--small-radius);
      }

      summary {
        position: relative;
        padding: 21px 40px 21px 0;
        color: var(--navy);
        font-weight: 850;
        cursor: pointer;
        list-style: none;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      summary::after {
        position: absolute;
        top: 50%;
        right: 0;
        width: 29px;
        height: 29px;
        display: grid;
        place-items: center;
        content: "+";
        background: var(--cream);
        border-radius: 50%;
        transform: translateY(-50%);
      }

      details[open] summary::after {
        content: "−";
      }

      details p {
        padding-right: 30px;
        padding-bottom: 20px;
        color: var(--muted);
      }

      .final-cta {
        text-align: center;
      }

      .final-cta h2 {
        max-width: 800px;
        margin-inline: auto;
      }

      .final-cta .lead {
        margin: 0 auto 26px;
        color: rgba(255, 255, 255, 0.78);
      }

      .final-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
      }

      .site-footer {
        padding: 52px 0 100px;
        color: rgba(255, 255, 255, 0.72);
        background: var(--navy-dark);
      }

      .footer-grid {
        display: grid;
        gap: 38px;
        grid-template-columns: 1.25fr 0.75fr 0.75fr;
      }

      .footer-logo {
        width: 82px;
        height: 82px;
        margin-bottom: 15px;
        object-fit: contain;
        border-radius: 50%;
      }

      .footer-heading {
        margin-bottom: 14px;
        color: var(--white);
        font-size: 0.82rem;
        font-weight: 900;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .footer-links {
        display: grid;
        gap: 8px;
      }

      .footer-links a {
        color: rgba(255, 255, 255, 0.72);
        text-decoration: none;
      }

      .copyright {
        margin-top: 39px;
        padding-top: 25px;
        border-top: 1px solid rgba(255, 255, 255, 0.11);
        font-size: 0.82rem;
      }

      .mobile-booking-bar {
        position: fixed;
        z-index: 1100;
        right: 0;
        bottom: 0;
        left: 0;
        display: none;
        grid-template-columns: 1fr auto;
        gap: 9px;
        padding: 10px 13px;
        background: rgba(255, 255, 255, 0.98);
        border-top: 1px solid var(--border);
        box-shadow: 0 -8px 28px rgba(23, 59, 76, 0.13);
      }

      .mobile-booking-bar .button {
        min-height: 49px;
        padding-inline: 17px;
      }

      :focus-visible {
        outline: 3px solid rgba(173, 149, 97, 0.6);
        outline-offset: 4px;
      }

      @media (max-width: 1000px) {
        .desktop-nav {
          display: none;
        }

        .menu-button {
          display: grid;
        }

        .hero-grid,
        .about-grid,
        .review-feature,
        .location-grid {
          grid-template-columns: 1fr;
        }

        .hero-copy {
          text-align: center;
        }

        .hero-copy .lead {
          margin-inline: auto;
        }

        .hero-actions,
        .hero-points {
          justify-content: center;
        }

        .treatment-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .social-grid {
          grid-template-columns: 1fr;
        }

        .footer-grid {
          grid-template-columns: 1fr 1fr;
        }

        .footer-grid > :first-child {
          grid-column: 1 / -1;
        }
      }

      @media (max-width: 700px) {
        .container {
          width: min(calc(100% - 28px), var(--page-width));
        }

        .section {
          padding: 68px 0;
        }

        .header-inner {
          min-height: 72px;
        }

        .brand img {
          width: 50px;
          height: 50px;
        }

        .brand-copy strong {
          font-size: 0.96rem;
        }

        .brand-copy span {
          display: none;
        }

        .hero {
          padding: 52px 0 77px;
        }

        h1 {
          font-size: clamp(2.45rem, 13vw, 3.95rem);
        }

        .hero-actions {
          display: grid;
        }

        .hero-actions .button {
          width: 100%;
        }

        .hero-card {
          right: 0;
          bottom: -28px;
          max-width: 225px;
        }

        .booking-strip {
          margin-top: -7px;
        }

        .booking-strip-inner {
          padding: 24px;
          grid-template-columns: 1fr;
          text-align: center;
        }

        .booking-strip-inner .button {
          width: 100%;
        }

        .treatment-grid,
        .gallery-grid,
        .reviews-grid,
        .footer-grid {
          grid-template-columns: 1fr;
        }

        .footer-grid > :first-child {
          grid-column: auto;
        }

        .location-actions,
        .review-links {
          display: grid;
        }

        .location-actions .button,
        .review-links .button {
          width: 100%;
        }

        .mobile-booking-bar {
          display: grid;
        }

        .site-footer {
          padding-bottom: 120px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="topbar">
      Based at Abshot Country Club in Titchfield Common.
      <a href={links.treatwell} target="_blank" rel="noopener noreferrer">
        Book online with Treatwell
      </a>
    </div>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#home" aria-label="Forever Young Beauty home">
          <img
            src="/images/fyb-logo2.png"
            alt="Forever Young Beauty by Layla logo"
            width="59"
            height="59"
          />

          <span class="brand-copy">
            <strong>Forever Young Beauty</strong>
            <span>By Layla · Titchfield Common</span>
          </span>
        </a>

        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#treatments">Treatments</a>
          <a href="#results">Results</a>
          <a href="#reviews">Reviews</a>
          <a href="#location">Find us</a>

          <a
            class="button button-treatwell"
            href={links.treatwell}
            target="_blank"
            rel="noopener noreferrer"
          >
            Book on Treatwell
          </a>
        </nav>

        <button
          class="menu-button"
          id="menu-button"
          type="button"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="mobile-navigation"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M4 7h16M4 12h16M4 17h16"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>

      <nav
        class="mobile-nav"
        id="mobile-navigation"
        aria-label="Mobile navigation"
      >
        <a href="#about">About</a>
        <a href="#treatments">Treatments</a>
        <a href="#results">Before and after</a>
        <a href="#reviews">Reviews</a>
        <a href="#location">Find us</a>
        <a href="#faq">FAQs</a>
        <a href={links.treatwell} target="_blank" rel="noopener noreferrer">
          Book on Treatwell
        </a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" id="home">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Beauty at Abshot · Titchfield Common</p>

            <h1>Advanced beauty, skin and wellness treatments</h1>

            <p class="lead">
              Personalised facials, advanced skin treatments, massage,
              waxing, hair restoration, body treatments and aesthetics in a
              calm, welcoming treatment room near Fareham.
            </p>

            <div class="hero-actions">
              <a
                class="button button-treatwell"
                href={links.treatwell}
                target="_blank"
                rel="noopener noreferrer"
              >
                View availability and book
              </a>

              <a
                class="button button-whatsapp"
                href={links.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
              >
                Message on WhatsApp
              </a>

              <a class="button button-light" href={links.phone}>
                Call {business.phoneDisplay}
              </a>
            </div>

            <div class="hero-points">
              <span>Personalised treatments</span>
              <span>Private treatment room</span>
              <span>Online booking</span>
            </div>
          </div>

          <div class="hero-image-wrap">
            <img
              class="hero-image"
              src="/images/layla-treatment.jpg"
              alt="Layla carrying out a professional facial treatment at Forever Young Beauty"
              width="1240"
              height="1240"
              fetchpriority="high"
            />

            <div class="hero-card">
              <strong>Personal care from Layla</strong>
              <span>
                Ask a question before booking or view current availability on
                Treatwell.
              </span>
            </div>
          </div>
        </div>
      </section>

      <div class="booking-strip">
        <div class="container">
          <div class="booking-strip-inner">
            <div>
              <h2>Ready to book your appointment?</h2>
              <p>
                View the current treatment menu and live appointment
                availability through Treatwell.
              </p>
            </div>

            <a
              class="button button-gold"
              href={links.treatwell}
              target="_blank"
              rel="noopener noreferrer"
            >
              Open Treatwell booking
            </a>
          </div>
        </div>
      </div>

      <section class="section" id="about">
        <div class="container about-grid">
          <div>
