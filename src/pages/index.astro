    <script is:inline>
      (() => {
        const loader = document.getElementById("opening-loader");
        const body = document.body;

        if (!loader) {
          body.classList.remove("loader-active");
          return;
        }

        let dismissed = false;

        const dismiss = () => {
          if (dismissed) return;
          dismissed = true;
          loader.classList.add("is-leaving");
          body.classList.remove("loader-active");
          window.setTimeout(() => loader.remove(), 700);
        };

        // Respect a reduced-motion preference by skipping the hold entirely.
        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        const hold = reduceMotion ? 0 : 2100;

        const start = () => window.setTimeout(dismiss, hold);

        if (document.readyState === "complete") {
          start();
        } else {
          window.addEventListener("load", start, { once: true });
        }

        /*
          Safety net. The old sequence only ever started on window.load, so a
          slow or failed image could leave the overlay covering the page
          indefinitely with scrolling locked. This guarantees it clears.
          Must stay comfortably above `hold`, or it would cut the intro short
          on slower connections.
        */
        window.setTimeout(dismiss, 4500);

        // Let anyone impatient tap or scroll straight past it.
        loader.addEventListener("click", dismiss);
        window.addEventListener("keydown", dismiss, { once: true });
      })();
    </script>

    <script is:inline>
      (() => {
        const button = document.getElementById("menu-button");
        const navigation =
          document.getElementById("mobile-navigation");

        if (!button || !navigation) return;

        const closeMenu = () => {
          navigation.classList.remove("open");
          document.body.classList.remove("menu-open");
          button.setAttribute("aria-expanded", "false");
          button.setAttribute("aria-label", "Open navigation");
        };

        button.addEventListener("click", () => {
          const isOpen = navigation.classList.toggle("open");

          document.body.classList.toggle("menu-open", isOpen);
          button.setAttribute("aria-expanded", String(isOpen));
          button.setAttribute(
            "aria-label",
            isOpen ? "Close navigation" : "Open navigation"
          );
        });

        navigation.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", closeMenu);
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") closeMenu();
        });
      })();
    </script>
