};

const links = {
  treatwell:
    "https://widget.treatwell.co.uk/place/forever-young-beauty-by-layla/",
  treatwellProfile:
    "https://www.treatwell.co.uk/place/forever-young-beauty-by-layla/",
  instagram:
    "https://www.instagram.com/foreveryoungbeauty_bylayla/",
  facebook:
    "https://www.facebook.com/share/1EFxmM1S14/",
  whatsapp:
    "https://wa.me/447799890398?text=Hello%20Layla%2C%20I%20would%20like%20to%20ask%20about%20a%20treatment.",
  phone: "tel:+447799890398",
  email: "mailto:layla.radestock@hotmail.com",
  maps: "https://maps.app.goo.gl/JPxvA3GcFrQov9SN9",
  // Canonical Google Business Profile link, built from the listing's CID
  // (0xb6bf12f61af5ccef = 13168264683678190831). The ?cid= form is stable and
  // survives name or address edits, unlike the long /maps/place/... URL and
  // unlike the previous search-results URL, which passed no signal at all.
  googleProfile: "https://www.google.com/maps?cid=13168264683678190831",
  googleReviews: "https://www.google.com/maps?cid=13168264683678190831",
};

// Confirmed coordinates for the treatment room at Abshot Country Club.
const geo = {
  latitude: 50.8485564,
  longitude: -1.2684209,
};

/*
  A correction to what I suggested earlier: I've dropped aggregateRating rather
  than filling it in.

  Google's structured data policy treats reviews a business collects and
  publishes about itself as "self-serving", and self-serving reviews are not
  eligible for review snippets on LocalBusiness or Organization markup. Google
  sources the stars for a local listing from the Business Profile instead. So
  the block would very likely have been ignored, and an inflated count is a
  manual action risk for no upside.

  For reference, the real numbers as they stand: Google shows 5.0 from 9
  reviews. The "over 500" figure on the page is the Treatwell total, which is
  fine as visible copy — it just isn't something to assert as schema here.
*/

/*
  Treatment categories, reconciled line by line against the Treatwell menu
  (July 2026).

  Rules for this array:

  1. No prices, no discounts, no durations. Treatwell is the single live source
     for all three, so the website can never go stale or contradict it.
  2. Every treatment named in a description must exist as a bookable listing on
     Treatwell. If it isn't on the menu, it doesn't go here — naming treatments
     that can't be booked sends people to a dead end and is exactly the problem
     that got Hair Restoration removed.
  3. Categories follow Treatwell's own navigation (Face, Body, Massage, Hair
     Removal, Men's) so the site and the booking menu read as one journey.

  Hair Restoration was removed: it was advertised here with supporting
  before/after photography, but there is no bookable hair restoration listing
  on Treatwell. If Layla still offers it by enquiry, it should come back with a
  WhatsApp CTA rather than a Treatwell one.
*/
const treatments = [
  {
    category: "Face",
    title: "Microneedling and Skin Rejuvenation",
    description:
      "Microneedling with Dermapen and plasma channeling, offered following consultation to support skin texture, tone and overall condition.",
  },
  {
    category: "Face",
    title: "Dermaplaning",
    description:
      "Professional exfoliation that removes surface build-up and fine facial hair for smoother-looking skin.",
  },
  {
    category: "Face",
    title: "Chemical Peels and Resurfacing",
    description:
      "BioRePeel CL3, the MONU+ Resurface and Peel system, and the Revival range of brightening, clarifying and anti-ageing peels.",
  },
  {
    category: "Face",
    title: "CACI Non-Surgical Treatments",
    description:
      "The full CACI range, including non-surgical face lift, jowl lift, eye revive and Hydratone.",
  },
  {
    category: "Face",
    title: "Hydrating and Specialist Facials",
    description:
      "Hydra Lift 6-in-1, Hydra Glow Renewal, Sonic Skin Renewal, High Frequency Therapy, purifying, eye revival and bespoke luxe facials.",
  },
  {
    category: "Face",
    title: "Radiofrequency and LED Light Therapy",
    description:
      "Collagen Lift radiofrequency treatment and Celluma LED light therapy, used on their own or alongside a facial.",
  },
  {
    category: "Men's",
    title: "Men's Facials and Waxing",
    description:
      "The Masculine Glow-Up facial, built around men's skin and shaving concerns, plus back, chest and combined back and chest waxing.",
  },
  {
    category: "Massage",
    title: "Massage Therapy",
    description:
      "Swedish, deep tissue, back deep tissue, back, neck and shoulder, aromatherapy, lymphatic drainage, trigger point therapy, pregnancy, abdominal, face, hand, foot and bespoke massage, plus the Top to Toe face and body treatment.",
  },
  {
    category: "Body",
    title: "Body, Cellulite and Weight-Loss Treatments",
    description:
      "MONUSpa hot oil and salt scrub polish, the Skin Bliss back treatment, cellulite reduction therapy and anti-cellulite vacuum treatment.",
  },
  {
    category: "Hair removal",
    title: "Waxing, Brows and Tinting",
    description:
      "Facial and body waxing, leg, underarm and forearm waxing, bikini, Brazilian, Playboy and Hollywood waxing, men's waxing, eyebrow shaping and eyebrow and eyelash tinting.",
  },
  {
    category: "Aesthetics",
    title: "Jalupro Injectable Skin Treatments",
    description:
      "Amino acid based injectable treatments for the eye area, lips and face, including Super Hydro V-Lift and Face AART. Booked after a short consultation.",
  },
  {
    /*
      Deliberately unnamed.

      UK law prohibits advertising prescription-only medicines to the public
      (Human Medicines Regulations 2012), and botulinum toxin is a POM. The ASA
      has upheld complaints against clinics for naming it or using terms that
      clearly point to it. Keep this entry generic — do not add "anti-wrinkle
      injections", "botox", brand names, prices or before/after imagery for POM
      treatments here, even though Treatwell lists them.

      Jalupro is a medical device rather than a POM, which is why it sits above
      as a named treatment. If the aesthetics offering changes, get the wording
      checked before publishing.
    */
    category: "Aesthetics",
    title: "Consultation-Led Aesthetic Treatments",
    description:
      "Selected treatments available following an appropriate consultation and suitability assessment. Please enquire.",
  },
  {
    category: "Wellness",
    title: "B12 Vitamin Injections",
    description:
      "Available following appropriate screening and suitability checks.",
  },
];

const reviews = [
  {
    quote:
