    {/*
      One shared lightbox, driven by data attributes on any button that wants
      it. Native <dialog> rather than a hand-built overlay: it handles focus
      trapping, Escape to close and the backdrop for free, which is a lot of
      accessibility work not to have to write or maintain.
    */}
    <dialog class="lightbox" data-lightbox aria-label="Enlarged photograph">
      <button
        class="lightbox-close"
        type="button"
        data-lightbox-close
        aria-label="Close photograph"
      >
        <span aria-hidden="true">&times;</span>
      </button>
      <img data-lightbox-image src="" alt="" />
    </dialog>

    <script is:inline>
      (() => {
        const loader = document.getElementById("opening-loader");
        const body = document.body;

        if (!loader) {
          body.classList.remove("loader-active");
          return;
        }

        let dismissed = false;

        const dismiss = () => {
          if (dismissed) return;
          dismissed = true;
          loader.classList.add("is-leaving");
          body.classList.remove("loader-active");
          window.setTimeout(() => loader.remove(), 700);
        };

        // Respect a reduced-motion preference by skipping the hold entirely.
        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        const hold = reduceMotion ? 0 : 2100;

        const start = () => window.setTimeout(dismiss, hold);

        if (document.readyState === "complete") {
          start();
        } else {
          window.addEventListener("load", start, { once: true });
        }

        /*
          Safety net. The old sequence only ever started on window.load, so a
          slow or failed image could leave the overlay covering the page
          indefinitely with scrolling locked. This guarantees it clears.
          Must stay comfortably above `hold`, or it would cut the intro short
          on slower connections.
        */
        window.setTimeout(dismiss, 4500);

        // Let anyone impatient tap or scroll straight past it.
        loader.addEventListener("click", dismiss);
        window.addEventListener("keydown", dismiss, { once: true });
      })();
    </script>

    <script is:inline>
      (() => {
        const button = document.getElementById("menu-button");
        const navigation =
          document.getElementById("mobile-navigation");

        if (!button || !navigation) return;

        const closeMenu = () => {
          navigation.classList.remove("open");
          document.body.classList.remove("menu-open");
          button.setAttribute("aria-expanded", "false");
          button.setAttribute("aria-label", "Open navigation");
        };

        button.addEventListener("click", () => {
          const isOpen = navigation.classList.toggle("open");

          document.body.classList.toggle("menu-open", isOpen);
          button.setAttribute("aria-expanded", String(isOpen));
          button.setAttribute(
            "aria-label",
            isOpen ? "Close navigation" : "Open navigation"
          );
        });

        navigation.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", closeMenu);
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") closeMenu();
        });
      })();
    </script>

    <script is:inline>
      /*
        Carousel enhancement.

        The markup is already usable without this: the track is a scroll-snap
        row, so swiping and keyboard scrolling work natively. This adds arrows
        and dot indicators, and only reveals them by setting .is-ready — so if
        the script fails, you get a plain swipeable row rather than dead
        controls.
      */
      (() => {
        const carousels = document.querySelectorAll("[data-carousel]");
        if (!carousels.length) return;

        carousels.forEach((carousel) => {
          const track = carousel.querySelector("[data-carousel-track]");
          const prev = carousel.querySelector("[data-carousel-prev]");
          const next = carousel.querySelector("[data-carousel-next]");
          const dotsHolder = carousel.querySelector("[data-carousel-dots]");
          const slides = Array.from(
            track ? track.querySelectorAll(".carousel-slide") : []
          );

          if (!track || slides.length < 2) return;

          // Build one dot per slide.
          const dots = slides.map((slide, index) => {
            const dot = document.createElement("button");
            dot.type = "button";
            dot.className = "carousel-dot";
            dot.setAttribute("aria-label", `Go to item ${index + 1}`);
            dot.addEventListener("click", () => {
              track.scrollTo({ left: slide.offsetLeft - track.offsetLeft });
            });
            dotsHolder && dotsHolder.appendChild(dot);
            return dot;
          });

          const step = () =>
            slides.length > 1
              ? slides[1].offsetLeft - slides[0].offsetLeft
              : track.clientWidth;

          prev &&
            prev.addEventListener("click", () => {
              track.scrollBy({ left: -step() });
            });
          next &&
            next.addEventListener("click", () => {
              track.scrollBy({ left: step() });
            });

          /*
            Which slide is "current" is derived from scroll position rather than
            tracked in a variable, so native swiping, the arrows and the dots
            can never disagree about where we are.
          */
          const sync = () => {
            const centre = track.scrollLeft + track.clientWidth / 2;
            let active = 0;
            let best = Infinity;

            slides.forEach((slide, index) => {
              const slideCentre =
                slide.offsetLeft - track.offsetLeft + slide.offsetWidth / 2;
              const distance = Math.abs(slideCentre - centre);
              if (distance < best) {
                best = distance;
                active = index;
              }
            });

            dots.forEach((dot, index) => {
              if (index === active) {
                dot.setAttribute("aria-current", "true");
              } else {
                dot.removeAttribute("aria-current");
              }
            });

            // 2px tolerance: sub-pixel scroll widths otherwise leave the end
            // arrow enabled when there is nothing left to scroll to.
            const maxScroll = track.scrollWidth - track.clientWidth;
            if (prev) prev.disabled = track.scrollLeft <= 2;
            if (next) next.disabled = track.scrollLeft >= maxScroll - 2;
          };

          let queued = false;
          track.addEventListener("scroll", () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => {
              queued = false;
              sync();
            });
          });

          window.addEventListener("resize", sync);

          // Pause any playing video when it is scrolled out of view.
          const players = Array.from(track.querySelectorAll("video"));
          if (players.length && "IntersectionObserver" in window) {
            const watcher = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (!entry.isIntersecting && !entry.target.paused) {
                    entry.target.pause();
                  }
                });
              },
              { root: track, threshold: 0.5 }
            );
            players.forEach((player) => watcher.observe(player));
          }

          carousel.classList.add("is-ready");
          sync();
        });
      })();
    </script>

    <script is:inline>
      /*
        Lightbox. Any element carrying data-lightbox-src opens the shared
        dialog with that image, so adding more later needs no extra script.

        <dialog>.showModal() gives focus trapping and Escape-to-close for free.
        The only thing it doesn't handle is clicking the backdrop, which is
        below — the dialog fills its own box, so a click landing outside the
        image bounds is a backdrop click.
      */
      (() => {
        const dialog = document.querySelector("[data-lightbox]");
        const image = dialog && dialog.querySelector("[data-lightbox-image]");
        const triggers = document.querySelectorAll("[data-lightbox-src]");

        if (!dialog || !image || !triggers.length) return;

        // No <dialog> support: leave the thumbnails as plain, inert images
        // rather than wiring up buttons that would do nothing.
        if (typeof dialog.showModal !== "function") return;

        triggers.forEach((trigger) => {
          trigger.addEventListener("click", () => {
            image.src = trigger.dataset.lightboxSrc;
            image.alt = trigger.dataset.lightboxAlt || "";
            dialog.showModal();
          });
        });

        const close = () => dialog.close();

        const closeButton = dialog.querySelector("[data-lightbox-close]");
        closeButton && closeButton.addEventListener("click", close);

        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) close();
        });

        // Drop the source on close so a large image isn't held in memory, and
        // so the next open never flashes the previous picture.
        dialog.addEventListener("close", () => {
          image.removeAttribute("src");
          image.alt = "";
        });
      })();
    </script>
  </body>
</html>