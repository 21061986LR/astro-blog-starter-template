---
// Forever Young Beauty by Layla — SEO-optimised homepage

const business = {
  name: "Forever Young Beauty by Layla",
  phone: "+447799890398",
  phoneDisplay: "07799 890398",
  email: "layla.radestock@hotmail.com",
  street: "Beauty at Abshot, Abshot Country Club, Little Abshot Road",
  locality: "Titchfield Common, Fareham",
  region: "Hampshire",
  postcode: "PO14 4LN",
  lat: 50.8482589,
  lng: -1.2688614,
  ratingValue: "5.0",
  reviewCount: "567",
  url: "https://www.foreveryoungbeautybylayla.co.uk",
  instagram: "https://www.instagram.com/foreveryoungbeauty_bylayla",
  facebook: "https://www.facebook.com/foreveryoungbeautybylayla",
  treatwell: "https://www.treatwell.co.uk/place/forever-young-beauty-by-layla/",
  googleReviews: "https://share.google/btFZbelPi8zLpwQBJ",
};

const title =
  "Forever Young Beauty by Layla | Beauty Salon Fareham — Facials, Massage & Aesthetics, Titchfield Common";
const description =
  "5-star beauty salon at Abshot Country Club, Fareham. CACI facials, dermaplaning, microneedling, massage, waxing & advanced aesthetics. Serving Titchfield, Locks Heath, Whiteley & Park Gate. Over 500 five-star reviews. Book online.";

const treatments = [
  {
    name: "CACI Non-Surgical Facials",
    desc: "The celebrity-favourite non-surgical facelift. Microcurrent therapy lifts and tones facial muscles — including the targeted CACI Jowl Lift for a firmer jawline.",
  },
  {
    name: "Dermaplaning",
    desc: "Instantly smoother, brighter skin. Gentle exfoliation removes dead skin cells and peach fuzz, leaving a flawless base for skincare and make-up.",
  },
  {
    name: "Microneedling & Skin Rejuvenation",
    desc: "Collagen-boosting treatments for fine lines, acne scarring and uneven texture, alongside LED light therapy, face peels and targeted acne treatments.",
  },
  {
    name: "Massage Therapy",
    desc: "Aromatherapy, Swedish, deep tissue, pregnancy and lymphatic drainage massage in a calm, private treatment room. Full body or back, neck and shoulders.",
  },
  {
    name: "Body Contouring",
    desc: "Cellulite reduction therapy and radio frequency body treatments to smooth, firm and tighten.",
  },
  {
    name: "Waxing & Tinting",
    desc: "Full waxing menu for ladies and men — from lip and brow to Hollywood — plus eyebrow and eyelash tinting.",
  },
];

// Real verified reviews supplied from the salon's own Treatwell listing
// and Google Business Profile (July 2026).
const reviews = [
  {
    quote:
      "Layla is very professional, caring and friendly. She makes sure you are comfortable and relaxed during the treatment. I will definitely be returning on a regular basis.",
    author: "Corinne",
    treatment: "CACI Facial",
    source: "Treatwell verified review",
  },
  {
    quote:
      "Layla is amazing! I have had loads of facials over the years, however this was by far the best. Layla is diligent, knowledgeable and is a wonderful therapist. Thank you!",
    author: "Maxine",
    treatment: "Facial",
    source: "Google review",
  },
  {
    quote:
      "Layla is just wonderful. I've recommended her to so many friends and they are all now also returning customers. 10/10 every visit.",
    author: "Nicky",
    treatment: "Pregnancy Massage",
    source: "Treatwell verified review",
  },
  {
    quote:
      "Layla is always excellent. She is very professional, thorough and attentive, and the treatment is carried out in a calm, relaxing environment. She is also very good at putting you at ease, which makes the whole experience much more comfortable. I am a regular customer and would highly recommend her.",
    author: "Terry",
    treatment: "Men's Waxing",
    source: "Treatwell verified review",
  },
  {
    quote:
      "Fabulous facial as always. Layla never rushes you and is very experienced.",
    author: "Caroline",
    treatment: "CACI Facial",
    source: "Treatwell verified review",
  },
  {
    quote:
      "Great treatment as always, and Layla had a cancellation and kindly fitted me in for a massage last minute which was amazing. I really appreciated her being so accommodating with the last minute request!",
    author: "Anna",
    treatment: "Ladies' Waxing",
    source: "Treatwell verified review",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "BeautySalon",
  "@id": `${business.url}/#salon`,
  name: business.name,
  description:
    "Beauty and aesthetic treatments in Fareham, Hampshire — CACI facials, dermaplaning, microneedling, massage, waxing and advanced aesthetics.",
  url: business.url,
  telephone: business.phone,
  email: business.email,
  image: `${business.url}/images/hero-layla.jpg`,
  logo: `${business.url}/images/fyb-logo.png`,
  currenciesAccepted: "GBP",
  paymentAccepted: "Cash, Credit Card, Debit Card",
  address: {
    "@type": "PostalAddress",
    streetAddress: business.street,
    addressLocality: business.locality,
    addressRegion: business.region,
    postalCode: business.postcode,
    addressCountry: "GB",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: business.lat,
    longitude: business.lng,
  },
  hasMap: "https://maps.app.goo.gl/5pksDnVJJNuWunbZ9",
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Thursday"],
      opens: "11:00",
      closes: "19:30",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Friday",
      opens: "12:00",
      closes: "19:30",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "11:00",
      closes: "15:00",
    },
  ],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: business.ratingValue,
    reviewCount: business.reviewCount,
    bestRating: "5",
  },
  areaServed: [
    "Fareham",
    "Titchfield",
    "Titchfield Common",
    "Locks Heath",
    "Whiteley",
    "Park Gate",
    "Warsash",
    "Stubbington",
    "Portsmouth",
    "Southampton",
  ].map((name) => ({ "@type": "Place", name })),
  sameAs: [
    business.instagram,
    business.facebook,
    business.treatwell,
  ],
  makesOffer: treatments.map((t) => ({
    "@type": "Offer",
    itemOffered: { "@type": "Service", name: t.name, description: t.desc },
  })),
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${business.url}/`} />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="GB-HAM" />
    <meta name="geo.placename" content="Fareham" />
    <meta name="geo.position" content={`${business.lat};${business.lng}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="business.business" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${business.url}/`} />
    <meta property="og:image" content={`${business.url}/images/og-image.jpg`} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={business.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${business.url}/images/og-image.jpg`} />

    <!-- LocalBusiness structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <style>
      :root {
        --navy: #1b3a4c;
        --navy-deep: #142c3a;
        --ink: #1b3a4c;
        --soft: #57606b;
        --silver: #d1d3d4;
        --gold: #b09a6e;
        --gold-dark: #94804f;
        --mist: #eef1f3;
        --line: #dce2e7;
        --paper: #fcfdfd;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        font-family: "Avenir Next", "Segoe UI", system-ui, sans-serif;
        color: var(--ink);
        background: var(--paper);
        line-height: 1.65;
      }
      h1, h2, h3 { font-family: Georgia, "Times New Roman", serif; font-weight: 500; }
      img, video { max-width: 100%; height: auto; display: block; }
      a { color: var(--gold-dark); }
      .wrap { max-width: 1040px; margin: 0 auto; padding: 0 1.25rem; }
      section { padding: 3.5rem 0; }
      section + section { border-top: 1px solid var(--line); }
      .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 0.72rem;
        color: var(--gold-dark);
        margin-bottom: 0.5rem;
      }
      h2 { font-size: 1.75rem; margin-bottom: 1.25rem; }

      /* Hero — brand navy, matching the logo and share image */
      /* Hero: photo + navy gradient on mobile, split layout on desktop */
      .hero { position: relative; background: var(--navy); color: var(--silver); overflow: hidden; }
      .hero-photo {
        position: absolute; inset: 0; width: 100%; height: 100%;
        object-fit: cover; object-position: 50% 28%;
      }
      .hero-veil {
        position: absolute; inset: 0;
        background: linear-gradient(to bottom,
          rgba(27,58,76,0.92) 0%,
          rgba(27,58,76,0.80) 18%,
          rgba(27,58,76,0.52) 38%,
          rgba(27,58,76,0.86) 66%,
          rgba(27,58,76,0.97) 100%);
      }
      .hero-inner {
        position: relative; z-index: 2; text-align: center;
        padding: 3.25rem 1.25rem 3.5rem;
        min-height: 78vh; display: flex; flex-direction: column; justify-content: space-between;
      }
      .hero img.logo { width: min(260px, 68vw); margin: 0 auto; height: auto; }
      .hero h1 { font-size: clamp(1.75rem, 6vw, 2.6rem); margin-bottom: 0.6rem; color: #fff; }
      .hero p.lede { max-width: 34rem; margin: 0 auto 1.1rem; color: var(--silver); font-size: 0.98rem; }
      .stars { color: var(--gold); letter-spacing: 0.15em; font-size: 1.05rem; }
      .rating-line { font-size: 0.9rem; color: var(--silver); margin-bottom: 1.5rem; }
      .cta-row { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
      .btn {
        display: inline-block;
        padding: 0.8rem 1.6rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
      }
      .btn-primary { background: var(--gold); color: var(--navy-deep); }
      .btn-primary:hover { background: var(--gold-dark); color: #fff; }
      .hero .btn-ghost { border: 1.5px solid var(--silver); color: var(--silver); }
      .btn-ghost { border: 1.5px solid var(--navy); color: var(--navy); }

      /* Treatments */
      .grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
      .card {
        background: var(--mist);
        border-radius: 14px;
        padding: 1.4rem 1.5rem;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        border: 1px solid transparent;
        transition: background 0.18s ease, border-color 0.18s ease,
          transform 0.18s ease;
      }
      .card:hover, .card:focus-visible {
        background: #fff;
        border-color: var(--gold);
        transform: translateY(-2px);
        outline: none;
      }
      .card:focus-visible { box-shadow: 0 0 0 3px rgba(176,154,110,0.45); }
      .card h3 { font-size: 1.12rem; margin-bottom: 0.4rem; color: var(--navy); }
      .card p { color: var(--soft); font-size: 0.93rem; flex: 1; }
      .card-cta {
        margin-top: 1rem;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--gold-dark);
      }
      .card:hover .card-cta { color: var(--navy); }

      @media (hover: none) {
        .card:hover { transform: none; }
      }

      /* Reels */
      /* shared row for social / review buttons */
      .btn-row {
        display: flex; gap: 0.7rem; flex-wrap: wrap;
        margin-top: 1.4rem;
      }
      .btn-row .btn { font-size: 0.9rem; padding: 0.7rem 1.35rem; }
      .btn-gold-ghost {
        border: 1.5px solid var(--gold); color: var(--gold-dark);
        background: #fff;
      }
      .btn-gold-ghost:hover { background: var(--gold); color: var(--navy-deep); }

      /* five-star lockup used as a section mark */
      .star-mark {
        display: block; color: var(--gold);
        font-size: clamp(1.6rem, 5vw, 2.1rem);
        letter-spacing: 0.12em; line-height: 1;
        margin-bottom: 0.6rem;
      }

      .reels { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
      .reels video {
        border-radius: 12px; width: 100%; height: auto;
        aspect-ratio: 9 / 16; object-fit: cover;
        background: var(--navy); display: block;
      }

      /* Reviews */
      .reviews { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
      blockquote {
        background: #fff;
        border: 1px solid var(--line);
        border-top: 3px solid var(--gold);
        border-radius: 14px;
        padding: 1.4rem 1.5rem;
      }
      blockquote p { font-style: italic; margin-bottom: 0.9rem; }
      blockquote footer { font-size: 0.85rem; color: var(--soft); }

      /* Hours + contact */
      .studio { display: grid; gap: 1rem; }
      .studio button {
        padding: 0; border: 0; background: none; cursor: zoom-in;
        border-radius: 14px; overflow: hidden; display: block;
        position: relative;
      }
      .studio img {
        width: 100%; height: auto;
        aspect-ratio: 16 / 9; object-fit: cover;
        border-radius: 14px;
        transition: transform 0.25s ease;
      }
      .studio button:hover img { transform: scale(1.02); }
      .studio figcaption {
        margin-top: 0.45rem; font-size: 0.82rem; color: var(--soft);
      }
      .studio button::after {
        content: "⤢"; position: absolute; right: 0.7rem; bottom: 0.7rem;
        background: rgba(27,58,76,0.82); color: #fff;
        width: 2rem; height: 2rem; border-radius: 50%;
        display: grid; place-items: center; font-size: 0.85rem;
      }

      dialog.lightbox {
        border: 0; padding: 0; background: transparent;
        max-width: 96vw; max-height: 94vh;
      }
      dialog.lightbox::backdrop { background: rgba(20,44,58,0.92); }
      dialog.lightbox img {
        max-width: 96vw; max-height: 88vh; width: auto; height: auto;
        border-radius: 10px;
      }
      dialog.lightbox p {
        color: var(--silver); text-align: center;
        font-size: 0.85rem; margin-top: 0.6rem;
      }

      .band {
        width: 100%; height: auto;
        aspect-ratio: 16 / 9; object-fit: cover;
        border-radius: 14px; margin-bottom: 1.75rem;
      }

      .split { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
      table.hours { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
      table.hours td { padding: 0.45rem 0; border-bottom: 1px solid var(--line); }
      table.hours td:last-child { text-align: right; color: var(--soft); }
      .map-embed { border: 0; width: 100%; height: 320px; border-radius: 14px; }
      address { font-style: normal; color: var(--soft); }

      footer.site {
        background: var(--navy-deep);
        color: var(--silver);
        padding: 2.5rem 0;
        font-size: 0.88rem;
        text-align: center;
      }
      footer.site a { color: var(--gold); }
      footer.site .social { margin-bottom: 1rem; display: flex; gap: 1.25rem; justify-content: center; }

      @media (min-width: 860px) {
        .hero-photo { width: 44%; left: auto; right: 0; object-position: 50% 34%; }
        .hero-veil {
          background: linear-gradient(to right,
            var(--navy) 0%, var(--navy) 54%,
            rgba(27,58,76,0.70) 62%, rgba(27,58,76,0.22) 74%, rgba(27,58,76,0) 84%);
        }
        .hero-inner {
          min-height: 62vh; text-align: left; align-items: flex-start;
          max-width: 1040px; margin: 0 auto; padding: 4rem 1.25rem;
          justify-content: center; gap: 1rem;
        }
        .hero-inner > * { max-width: 30rem; }
        .hero img.logo { margin: 0 0 1.5rem; }
        .hero p.lede { margin-left: 0; }
        .hero .cta-row { justify-content: flex-start; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }
    </style>
  </head>

  <body>
    <!-- HERO -->
    <header class="hero">
      <img
        class="hero-photo"
        src="/images/hero-layla.jpg"
        alt="Layla carrying out an LED light therapy facial at Forever Young Beauty, Fareham"
        width="720"
        height="1280"
        fetchpriority="high"
      />
      <div class="hero-veil"></div>

      <div class="hero-inner">
        <img
          class="logo"
          src="/images/fyb-wordmark-1.png"
          alt="Forever Young Beauty by Layla"
          width="520"
          height="176"
        />
        <div>
          <h1>Five-star beauty in Fareham</h1>
          <p class="lede">
            Facials, massage and advanced aesthetics in a calm, private
            treatment room at Abshot Country Club, Titchfield Common — minutes
            from Locks Heath, Whiteley and Park Gate.
          </p>
          <div class="stars" aria-label="Rated 5 out of 5 stars">★★★★★</div>
          <p class="rating-line">
            Over 500 five-star reviews · Treatwell Top Rated 2024 &amp; 2025
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" href={business.treatwell}>Book online</a>
            <a class="btn btn-ghost" href={`tel:${business.phone}`}
              >Call {business.phoneDisplay}</a
            >
          </div>
        </div>
      </div>
    </header>

    <section id="treatments">
      <div class="wrap">
        <p class="eyebrow">Treatments</p>
        <h2>Tailored treatments, from everyday beauty to advanced aesthetics</h2>
        <div class="grid">
          {
            treatments.map((t) => (
              <a class="card" href={business.treatwell}>
                <h3>{t.name}</h3>
                <p>{t.desc}</p>
                <span class="card-cta">Book on Treatwell →</span>
              </a>
            ))
          }
        </div>
        <p style="margin-top:1.5rem;">
          <a class="btn btn-primary" href={business.treatwell}
            >See the full menu &amp; book on Treatwell</a
          >
        </p>
      </div>
    </section>

    <!-- REELS -->
    <section id="fresh">
      <div class="wrap">
        <p class="eyebrow">Fresh from the treatment room</p>
        <h2>See recent results</h2>
        <div class="reels">
          <video
            src="/videos/reel1.mp4"
            poster="/images/poster1-1.jpg"
            controls
            preload="none"
            playsinline
            aria-label="LED light therapy treatment"></video>
          <video
            src="/videos/reel2.mp4"
            poster="/images/poster2-1.jpg"
            controls
            preload="none"
            playsinline
            aria-label="Advanced skin treatment"></video>
          <video
            src="/videos/reel3.mp4"
            poster="/images/poster3-1.jpg"
            controls
            preload="none"
            playsinline
            aria-label="Facial and skincare treatment"></video>
        </div>
        <p style="margin-top:1.25rem; color: var(--soft);">
          Daily results, offers and last-minute availability.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href={business.instagram}>Follow on Instagram</a>
          <a class="btn btn-ghost" href={business.facebook}>Find us on Facebook</a>
        </div>
      </div>
    </section>

    <!-- REVIEWS -->
    <section id="reviews">
      <div class="wrap">
        <p class="eyebrow">What clients say</p>
        <span class="star-mark" aria-hidden="true">★★★★★</span>
        <h2>Over 500 five-star reviews</h2>
        <div class="reviews">
          {
            reviews.map((r) => (
              <blockquote>
                <p>“{r.quote}”</p>
                <footer>
                  {r.author} · {r.treatment} · {r.source}
                </footer>
              </blockquote>
            ))
          }
        </div>
        <div class="btn-row">
          <a class="btn btn-gold-ghost" href={business.googleReviews}
            >Read our Google reviews</a
          >
          <a class="btn btn-gold-ghost" href={business.treatwell}
            >Verified reviews on Treatwell</a
          >
        </div>
      </div>
    </section>

    <!-- FIND US -->
    <section id="studio">
      <div class="wrap">
        <p class="eyebrow">Inside the studio</p>
        <h2>A calm, private treatment room</h2>
        <div class="studio">
          <figure>
            <button type="button" data-full="/images/entrance-wide.jpg"
              data-cap="The entrance at Abshot Country Club">
              <img
                src="/images/entrance-wide.jpg"
                alt="Entrance to Beauty at Abshot, Titchfield Common"
                loading="lazy"
                width="720"
                height="405"
              />
            </button>
            <figcaption>The entrance at Abshot Country Club</figcaption>
          </figure>
          <figure>
            <button type="button" data-full="/images/room-wide.jpg"
              data-cap="The private treatment room">
              <img
                src="/images/room-wide.jpg"
                alt="Private treatment room at Forever Young Beauty by Layla"
                loading="lazy"
                width="720"
                height="405"
              />
            </button>
            <figcaption>The private treatment room</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="find-us">
      <div class="wrap">
        <p class="eyebrow">Find us</p>
        <h2>In the heart of Titchfield Common</h2>
        <div class="split">
          <div>
            <address>
              <strong>{business.name}</strong><br />
              Beauty at Abshot, Abshot Country Club<br />
              Little Abshot Road, Titchfield Common<br />
              Fareham, Hampshire {business.postcode}
            </address>
            <p style="margin:1rem 0;">
              <a href={`tel:${business.phone}`}>{business.phoneDisplay}</a><br />
              <a href={`mailto:${business.email}`}>{business.email}</a>
            </p>
            <table class="hours" aria-label="Opening hours">
              <tr><td>Monday</td><td>11:00 – 19:30</td></tr>
              <tr><td>Tuesday</td><td>11:00 – 19:30</td></tr>
              <tr><td>Wednesday</td><td>Closed</td></tr>
              <tr><td>Thursday</td><td>11:00 – 19:30</td></tr>
              <tr><td>Friday</td><td>12:00 – 19:30</td></tr>
              <tr><td>Saturday</td><td>11:00 – 15:00</td></tr>
              <tr><td>Sunday</td><td>Closed</td></tr>
            </table>
            <p style="margin-top:1rem;">
              <a class="btn btn-ghost" href="https://maps.app.goo.gl/5pksDnVJJNuWunbZ9"
                >Get directions</a
              >
            </p>
          </div>
          <iframe
            class="map-embed"
            title="Map showing Forever Young Beauty by Layla at Abshot Country Club, Fareham"
            src="https://www.google.com/maps?q=Forever+Young+Beauty+By+Layla,+Abshot+Country+Club,+Little+Abshot+Rd,+Fareham+PO14+4LN&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>

    <footer class="site">
      <div class="wrap">
        <div class="social">
          <a href={business.instagram}>Instagram</a>
          <a href={business.facebook}>Facebook</a>
          <a href={business.treatwell}>Treatwell</a>
          <a href={business.googleReviews}>Google Reviews</a>
        </div>
        <p>
          {business.name} · Beauty at Abshot, Abshot Country Club, Little Abshot
          Road, Titchfield Common, Fareham {business.postcode}
        </p>
        <p>
          Serving Fareham, Titchfield, Locks Heath, Whiteley, Park Gate, Warsash
          &amp; Stubbington
        </p>
        <p>© 2026 {business.name}</p>
      </div>
    </footer>
    <dialog class="lightbox" id="lightbox">
      <img src="" alt="" />
      <p></p>
    </dialog>

    <script is:inline>
      (function () {
        var dlg = document.getElementById("lightbox");
        if (!dlg) return;
        var img = dlg.querySelector("img");
        var cap = dlg.querySelector("p");
        document.querySelectorAll(".studio button").forEach(function (b) {
          b.addEventListener("click", function () {
            img.src = b.dataset.full;
            img.alt = b.querySelector("img").alt;
            cap.textContent = b.dataset.cap || "";
            dlg.showModal();
          });
        });
        dlg.addEventListener("click", function () { dlg.close(); });
      })();
    </script>
  </body>
</html>