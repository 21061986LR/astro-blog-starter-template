    source: "Client review",
  },
];

const openingHours = [
  ["Monday", "11:00 – 19:30"],
  ["Tuesday", "11:00 – 19:30"],
  ["Wednesday", "Closed"],
  ["Thursday", "11:00 – 19:30"],
  ["Friday", "12:00 – 19:30"],
  ["Saturday", "11:00 – 15:00"],
  ["Sunday", "Closed"],
];

const areas = [
  "Titchfield Common",
  "Titchfield",
  "Locks Heath",
  "Park Gate",
  "Whiteley",
  "Warsash",
  "Sarisbury Green",
  "Stubbington",
  "Fareham",
  "Hamble",
  "Hedge End",
  "Gosport",
  "Southampton",
  "Portsmouth",
];

// States the overall rating rather than claiming every individual review is
// five stars — a 5.0 average and "500 five-star reviews" are not the same
// assertion, and only the first one is verifiable on Treatwell.
// "Over 560" is a floor, so it stays true as the total climbs. Treatwell showed
// 5.0 from 567 when last checked, July 2026. Only revisit at a real milestone.
const reviewsClaim = "Rated 5.0 on Treatwell from over 560 reviews";

// FAQs now live in one place and drive both the visible <details> list and the
// FAQPage structured data. Google requires the two to match, so keeping a single
// source of truth stops them drifting apart when copy gets edited.
const faqs = [
  {
    question: "How do I book a treatment?",
    answer:
      "Select any View treatments and book button to see the full treatment menu, current prices and available appointment times on Treatwell.",
  },
  {
    question: "Can I ask a question before booking?",
    answer: `Yes. Message Layla on WhatsApp or call ${business.phoneDisplay}.`,
  },
  {
    question: "Do I need a patch test?",
    answer:
      "Some treatments do, including tinting and certain skin treatments. Patch tests are free and take about five minutes, and can be booked on Treatwell like any other appointment. If you are not sure whether you need one, message Layla before booking.",
  },
  {
    question: "Are treatment results guaranteed?",
    answer:
      "No. Results vary according to the client, treatment, suitability, skin or hair condition, lifestyle and aftercare.",
  },
  {
    question: "Where is the treatment room?",
    answer:
      "Beauty at Abshot, Abshot Country Club, Little Abshot Road, Titchfield Common, Fareham, PO14 4LN.",
  },
  {
    question: "Is there parking at Abshot Country Club?",
    answer:
      "Yes. There is free on-site parking, with the treatment room a short walk from the car park.",
  },
  {
    question: "Which areas do clients travel from?",
    answer:
      "Most clients come from Titchfield Common, Locks Heath, Park Gate, Whiteley, Warsash, Sarisbury Green, Stubbington and Fareham, with others travelling from Gosport, Hedge End, Southampton and Portsmouth.",
  },
];

// Machine-readable mirror of the openingHours display array above.
const openingHoursSchema = [
  { days: ["Monday", "Tuesday", "Thursday"], opens: "11:00", closes: "19:30" },
  { days: ["Friday"], opens: "12:00", closes: "19:30" },
  { days: ["Saturday"], opens: "11:00", closes: "15:00" },
].map((slot) => ({
  "@type": "OpeningHoursSpecification",
  dayOfWeek: slot.days,
  opens: slot.opens,
  closes: slot.closes,
}));

const schema = {
  "@context": "https://schema.org",
  "@type": ["BeautySalon", "LocalBusiness"],
  "@id": "https://foreveryoungbeautybylayla.co.uk/#business",
  name: business.name,
  url: "https://foreveryoungbeautybylayla.co.uk/",
  telephone: business.phoneInternational,
  email: business.email,
  description:
    "Facials, advanced skin treatments, massage, waxing, body treatments and aesthetics in Titchfield Common near Fareham.",
  logo:
    "https://foreveryoungbeautybylayla.co.uk/images/fyb-logo2.png",
  image: [
    "https://foreveryoungbeautybylayla.co.uk/images/og-image.jpg",
    "https://foreveryoungbeautybylayla.co.uk/images/layla-treatment.jpg",
  ],
  address: {
    "@type": "PostalAddress",
    streetAddress:
      "Beauty at Abshot, Abshot Country Club, Little Abshot Road",
    addressLocality: "Titchfield Common",
    // addressRegion should be the county alone — the town belongs in
    // addressLocality, and mixing them can weaken the address match.
    addressRegion: "Hampshire",
    postalCode: "PO14 4LN",
    addressCountry: "GB",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: geo.latitude,
    longitude: geo.longitude,
  },
  hasMap: links.maps,
  currenciesAccepted: "GBP",
  priceRange: "££",
  openingHoursSpecification: openingHoursSchema,
  areaServed: areas.map((area) => ({
    "@type": "Place",
    name: area,
  })),
  // Reuses the treatments array, so the service list can never drift out of
  // sync with what the page actually shows.
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Treatment menu",
    itemListElement: treatments.map((treatment) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: treatment.title,
        serviceType: treatment.category,
        description: treatment.description,
      },
      // No price emitted. Treatwell is the single live source for pricing, so
      // asserting a figure here would go stale the moment Layla changes one.
      url: links.treatwell,
    })),
  },
  sameAs: [
    links.instagram,
    links.facebook,
    links.treatwellProfile,
    links.googleProfile,
  ],
  potentialAction: {
    "@type": "ReserveAction",
    name: "Book an appointment on Treatwell",
    target: {
      "@type": "EntryPoint",
      urlTemplate: links.treatwell,
      inLanguage: "en-GB",
      actionPlatform: [
        "http://schema.org/DesktopWebPlatform",
        "http://schema.org/MobileWebPlatform",
      ],
    },
    result: {
      "@type": "Reservation",
      name: "Treatment booking",
    },
  },
};

// Separate FAQPage graph. This is the block that can win an expandable FAQ
// result in Google, and it only stays valid while the same questions and
// answers remain visible on the page.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://foreveryoungbeautybylayla.co.uk/#faq",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    {/*
      Title was 76 characters, so Google truncated it, and it led with
      Titchfield Common — accurate, but a fraction of Fareham's search volume.
      This is 54 characters and leads with the term people actually type.
    */}
    <title>Beauty &amp; Skin Treatments Fareham | Forever Young Beauty</title>

    {/*
      Description now names the individual treatments people search for and
      leads with social proof. Not a ranking factor, but it decides whether
      anyone clicks the result once it's shown.
    */}
    <meta
      name="description"
      content={`Facials, microneedling, dermaplaning, CACI, massage and waxing in Titchfield Common, Fareham. ${reviewsClaim}. Book online with Treatwell.`}
    />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1"
    />

    <link
      rel="canonical"
      href="https://foreveryoungbeautybylayla.co.uk/"
    />

    <meta name="theme-color" content="#173b4c" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Forever Young Beauty by Layla" />
    <meta
      property="og:title"
      content="Forever Young Beauty by Layla | Titchfield Common, Fareham"
    />
    <meta
      property="og:description"
      content={`Personalised facials, advanced skin treatments, massage and waxing at Beauty at Abshot. ${reviewsClaim}.`}
    />
    <meta
      property="og:image:alt"
      content="Layla carrying out a professional facial treatment at Beauty at Abshot"
    />
    <meta
      property="og:url"
      content="https://foreveryoungbeautybylayla.co.uk/"
    />
    <meta
      property="og:image"
      content="https://foreveryoungbeautybylayla.co.uk/images/og-image.jpg"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:image"
      content="https://foreveryoungbeautybylayla.co.uk/images/og-image.jpg"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    ></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    ></script>

    <style is:global>
      :root {
        --navy: #173b4c;
        --navy-dark: #0d2937;
        --cream: #f7f3ed;
        --white: #ffffff;
        --gold: #aa925f;
        --gold-light: #dfcdac;
        --text: #243a45;
        --muted: #69757b;
        --border: rgba(23, 59, 76, 0.14);
        --green: #20965a;
        --treatwell: #ff5c65;
        --facebook: #1877f2;
        --shadow: 0 16px 42px rgba(13, 41, 55, 0.13);
        --radius: 26px;
        --small-radius: 16px;
        --page-width: 1180px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        /*
          Anchor targets must clear the sticky top block. This was 95px when
          only the header stuck; the topbar now sticks with it and wraps to two
          lines on narrow screens, so the offset has to cover both.
        */
        scroll-padding-top: 175px;
      }

      body {
        margin: 0;
        color: var(--text);
        background: var(--white);
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        line-height: 1.65;
      }

      body.menu-open {
        overflow: hidden;
      }

      img {
        display: block;
        max-width: 100%;
        height: auto;
      }

      a {
        color: inherit;
      }

      button {
        font: inherit;
      }

      h1,
      h2,
      h3 {
        margin-top: 0;
        color: var(--navy);
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 500;
        line-height: 1.08;
      }

      h1 {
        margin-bottom: 22px;
        font-size: clamp(2.6rem, 7vw, 5.6rem);
        letter-spacing: -0.045em;
      }

      h2 {
        margin-bottom: 18px;
        font-size: clamp(2.1rem, 5vw, 3.75rem);
        letter-spacing: -0.035em;
      }

      h3 {
        margin-bottom: 12px;
        font-size: 1.5rem;
      }

      p {
        margin-top: 0;
      }

      .container {
        width: min(calc(100% - 40px), var(--page-width));
        margin-inline: auto;
      }

      .section {
        padding: 88px 0;
      }

      .section-soft {
        background: var(--cream);
      }

      .section-dark {
        color: var(--white);
        background:
          radial-gradient(
            circle at top right,
            rgba(223, 205, 172, 0.16),
            transparent 38%
          ),
          var(--navy);
      }

      .section-dark h2,
      .section-dark h3 {
        color: var(--white);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 15px;
        color: var(--gold);
        font-size: 0.8rem;
        font-weight: 850;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        width: 32px;
        height: 2px;
        content: "";
        background: currentColor;
      }

      .lead {
        max-width: 760px;
        color: var(--muted);
        font-size: clamp(1.05rem, 2vw, 1.22rem);
      }

      .section-heading {
        max-width: 820px;
        margin: 0 auto 44px;
        text-align: center;
      }

      .section-heading .eyebrow {
        justify-content: center;
      }

      .section-heading .lead {
        margin-inline: auto;
      }

      /*
        The whole top block sticks as one unit, matching the fixed booking bar
        at the bottom. Sticky rather than fixed so it still occupies layout
        space and nothing needs a compensating padding-top on the body.
      */
      .site-top {
        position: sticky;
        z-index: 1000;
        top: 0;
      }

      /*
        Flex with wrap means the break falls between the sentence and the link
        rather than mid-phrase. One line on wide screens, two clean lines on a
        phone.
      */
      .topbar {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: center;
        gap: 2px 8px;
        padding: 9px 18px;
        color: rgba(255, 255, 255, 0.93);
        background: var(--navy-dark);
        font-size: 0.84rem;
        text-align: center;
      }

      .topbar a {
        color: var(--gold-light);
        font-weight: 850;
      }

      .site-header {
        border-bottom: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.97);
        backdrop-filter: blur(15px);
      }

      .header-inner {
        display: flex;
        min-height: 82px;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        color: var(--navy);
        text-decoration: none;
      }

      .brand img {
        width: 61px;
        height: 61px;
        object-fit: contain;
        border-radius: 50%;
      }

      .brand strong {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.16rem;
      }

      /*
        Mirrors the lockup inside the round logo: the wordmark with a smaller,
        letterspaced "by Layla" in gold sitting beneath it.
      */
      .brand-text {
        display: flex;
        flex-direction: column;
        gap: 1px;
        line-height: 1.15;
      }

      .brand-suffix {
        color: var(--gold);
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }

      .desktop-nav {
        display: flex;
        align-items: center;
        gap: 23px;
      }

      .desktop-nav > a:not(.button) {
        color: var(--navy);
        font-size: 0.91rem;
        font-weight: 800;
        text-decoration: none;
      }

      .menu-button {
        display: none;
        width: 50px;
        height: 50px;
        place-items: center;
        padding: 0;
        color: var(--navy);
        background: var(--cream);
        border: 0;
        border-radius: 50%;
        cursor: pointer;
      }

      .menu-button svg {
        width: 25px;
        height: 25px;
      }

      .mobile-nav {
        display: none;
        padding: 8px 20px 25px;
        background: var(--white);
      }

      .mobile-nav.open {
        display: grid;
        gap: 9px;
      }

      .mobile-nav a {
        padding: 13px 16px;
        color: var(--navy);
        background: var(--cream);
        border-radius: 12px;
        font-weight: 850;
        text-decoration: none;
      }

      .button {
        display: inline-flex;
        min-height: 52px;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 14px 22px;
        border: 2px solid transparent;
        border-radius: 999px;
        font-size: 0.96rem;
        font-weight: 850;
        line-height: 1.2;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition:
          transform 180ms ease,
          box-shadow 180ms ease;
      }

      .button:hover,
      .button:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 14px 29px rgba(13, 41, 55, 0.2);
      }

      .button-primary {
        color: var(--white);
        background: var(--navy);
      }

      .button-treatwell {
        color: var(--white);
        background: var(--treatwell);
      }

      .button-whatsapp {
        color: var(--white);
        background: var(--green);
      }

      .button-light {
        color: var(--navy);
        background: var(--white);
      }

      .button-gold {
        color: var(--navy-dark);
        background: var(--gold-light);
      }

      .hero-banner-section {
        padding: 34px 0 52px;
        background: var(--cream);
      }

      .hero-banner {
        overflow: hidden;
        width: 100%;
        background: var(--navy);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .hero-banner img {
        display: block;
        width: 100%;
        height: auto;
        object-fit: contain;
      }

      .hero-content {
        padding: 64px 0 80px;
        background:
          radial-gradient(
            circle at 10% 10%,
            rgba(223, 205, 172, 0.34),
            transparent 30%
          ),
          var(--white);
      }

      .hero-grid {
        display: grid;
        align-items: center;
        gap: 54px;
        grid-template-columns: 1.04fr 0.96fr;
      }

      .hero-copy .lead {
        margin-bottom: 0;
      }

      .hero-photo-wrap {
        width: 100%;
        margin-inline: auto;
      }

      .hero-photo {
        display: block;
        width: 100%;
        height: auto;
        object-fit: contain;
        object-position: center top;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .booking-strip {
        margin-top: -32px;
      }

      .booking-inner {
        display: grid;
        align-items: center;
        gap: 22px;
        padding: 28px 31px;
        color: var(--white);
        background: var(--navy);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        grid-template-columns: 1fr auto;
      }

      .booking-inner h2 {
        margin-bottom: 5px;
        color: var(--white);
        font-size: clamp(1.55rem, 3vw, 2.25rem);
      }

      .booking-inner p {
        margin-bottom: 0;
        color: rgba(255, 255, 255, 0.77);
      }

      .about-grid,
      .review-feature,
      .location-grid {
        display: grid;
        align-items: center;
        gap: 56px;
        grid-template-columns: 0.9fr 1.1fr;
      }

      .about-logo,
      .review-image {
        width: min(100%, 480px);
        margin-inline: auto;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .benefits {
        display: grid;
        gap: 13px;
        margin-top: 26px;
        padding: 0;
        list-style: none;
      }

      .benefits li {
        display: flex;
        gap: 12px;
      }

      .benefits li::before {
        width: 9px;
        height: 9px;
        flex: 0 0 auto;
        margin-top: 9px;
        content: "";
        background: var(--gold);
        border-radius: 50%;
      }

      .treatment-grid {
        display: grid;
        gap: 19px;
        grid-template-columns: repeat(3, 1fr);
      }

      .treatment-card {
        display: flex;
        min-height: 100%;
        flex-direction: column;
        padding: 27px;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 20px;
        box-shadow: 0 8px 23px rgba(23, 59, 76, 0.06);
      }

      .treatment-category {
        display: inline-flex;
        align-self: flex-start;
        margin-bottom: 16px;
        padding: 7px 11px;
        color: var(--navy);
        background: var(--cream);
        border-radius: 999px;
        text-transform: uppercase;
      }

      .treatwell-note {
        max-width: 60ch;
        margin: 12px 0 0;
        font-size: 0.86rem;
        line-height: 1.6;
        opacity: 0.75;
      }

      .treatment-card p {
        flex-grow: 1;
        margin-bottom: 18px;
        color: var(--muted);
        font-size: 0.93rem;
      }

      .card-link {
        color: var(--navy);
        font-size: 0.91rem;
        font-weight: 900;
        text-decoration: none;
      }

      .treatment-footer {
        margin-top: 37px;
        text-align: center;
      }

      .gallery-grid {
        display: grid;
        align-items: start;
        gap: 22px;
        grid-template-columns: repeat(2, 1fr);
      }

      .gallery-card {
        overflow: hidden;
        background: transparent;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .gallery-card img {
        display: block;
        width: 100%;
        height: auto;
        object-fit: contain;
        background: var(--cream);
      }

      .disclaimer {
        margin-top: 27px;
        padding: 18px 20px;
        color: var(--muted);
        background: var(--cream);
        border-radius: var(--small-radius);
        font-size: 0.84rem;
      }

      .review-feature-copy {
        padding: clamp(31px, 5vw, 49px);
        color: var(--white);
        background: var(--navy);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .review-feature-copy h2 {
        color: var(--white);
      }

      .review-feature-copy p {
        color: rgba(255, 255, 255, 0.8);
      }

      .reviews-grid {
        display: grid;
        gap: 22px;
        grid-template-columns: repeat(2, 1fr);
      }

      .review-card {
        padding: 35px;
        background: var(--white);
        border: 1px solid var(--border);
        border-top: 5px solid var(--gold);
        border-radius: var(--radius);
      }

      .review-card blockquote {
        margin: 0 0 24px;
        color: var(--navy);
        font-size: 1.1rem;
        font-style: italic;
        line-height: 1.75;
      }

      .review-card footer {
        color: var(--muted);
        font-size: 0.93rem;
      }

      .review-card footer strong {
        color: var(--navy);
      }

      .review-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
      }

      .social-grid {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(3, 1fr);
      }

      .social-card {
        display: grid;
        min-height: 112px;
        align-content: center;
        justify-items: center;
        gap: 5px;
        padding: 18px;
        color: var(--white);
        border-radius: var(--radius);
        text-align: center;
        text-decoration: none;
        box-shadow: var(--shadow);
      }

      .social-card strong {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.22rem;
      }

      .social-card span {
        color: rgba(255, 255, 255, 0.86);
        font-size: 0.86rem;
      }

      .social-whatsapp {
        background: var(--green);
      }

      .social-instagram {
        background:
          linear-gradient(
            135deg,
            #6337be,
            #a92b88 42%,
            #dc4259 72%,
            #ed9c38
          );
      }

      .social-facebook {
        background: var(--facebook);
      }

      /*
        The two room photographs are different shapes, so they are cropped to a
        common square here. Without this the grid row is set by the taller
        portrait image and the landscape one floats in a gap.
      */
      .room-grid img {
        aspect-ratio: 1 / 1;
        object-fit: cover;
        object-position: center;
      }

      .location-grid {
        align-items: start;
        grid-template-columns: 1.05fr 0.95fr;
      }

      .area-list {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 25px;
      }

      .area-list span {
        padding: 9px 13px;
        color: var(--navy);
        background: var(--cream);
        border-radius: 999px;
        font-size: 0.83rem;
        font-weight: 800;
      }

      .location-card {
        padding: 32px;
        color: var(--white);
        background: var(--navy);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .location-card h3 {
        color: var(--white);
      }

      .contact-list {
        display: grid;
        gap: 15px;
        margin: 25px 0;
      }

      .contact-list a {
        color: var(--gold-light);
        font-weight: 800;
      }

      .hours-list {
        margin: 27px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.17);
      }

      .hours-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 13px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.17);
      }

      .hours-row span:last-child {
        text-align: right;
      }

      .location-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .faq-list {
        display: grid;
        max-width: 870px;
        gap: 12px;
        margin-inline: auto;
      }

      details {
        padding: 0 22px;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--small-radius);
      }

      summary {
        position: relative;
        padding: 21px 40px 21px 0;
        color: var(--navy);
        font-weight: 850;
        cursor: pointer;
        list-style: none;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      summary::after {
        position: absolute;
        top: 50%;
        right: 0;
        width: 29px;
        height: 29px;
        display: grid;
        place-items: center;
        content: "+";
        background: var(--cream);
        border-radius: 50%;
        transform: translateY(-50%);
      }

      details[open] summary::after {
        content: "−";
      }

      details p {
        padding-bottom: 20px;
        color: var(--muted);
      }

      .final-cta {
        text-align: center;
      }

      .final-cta h2 {
        max-width: 800px;
        margin-inline: auto;
      }

      .final-cta .lead {
        margin: 0 auto 26px;
        color: rgba(255, 255, 255, 0.79);
      }

      .final-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
      }

      .site-footer {
        padding: 52px 0 105px;
        color: rgba(255, 255, 255, 0.73);
        background: var(--navy-dark);
      }

      .footer-grid {
        display: grid;
        gap: 38px;
        grid-template-columns: 1.25fr 0.75fr 0.75fr;
      }

      .footer-logo {
        width: 82px;
        height: 82px;
        margin-bottom: 15px;
        object-fit: contain;
        border-radius: 50%;
      }

      .footer-heading {
        margin-bottom: 14px;
        color: var(--white);
        font-size: 0.82rem;
        font-weight: 900;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .footer-links {
        display: grid;
        gap: 8px;
      }

      .footer-links a {
        color: rgba(255, 255, 255, 0.73);
        text-decoration: none;
      }

      .copyright {
        margin-top: 38px;
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        font-size: 0.82rem;
      }

      .mobile-booking-bar {
        position: fixed;
        z-index: 1100;
        right: 0;
        bottom: 0;
        left: 0;
        display: none;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
        padding: 10px 13px calc(10px + env(safe-area-inset-bottom));
        background: rgba(255, 255, 255, 0.98);
        border-top: 1px solid var(--border);
        box-shadow: 0 -8px 28px rgba(23, 59, 76, 0.14);
      }

      .mobile-booking-bar .button {
        width: 100%;
        min-height: 49px;
        padding-inline: 10px;
        white-space: nowrap;
      }

      :focus-visible {
        outline: 3px solid rgba(170, 146, 95, 0.6);
        outline-offset: 4px;
      }

      @media (max-width: 1000px) {
        .desktop-nav {
          display: none;
        }

        .menu-button {
          display: grid;
        }

        .hero-grid,
        .about-grid,
        .review-feature,
        .location-grid {
          grid-template-columns: 1fr;
        }

        .hero-copy {
          text-align: center;
        }

        .hero-copy .lead {
          margin-inline: auto;
        }

        .hero-actions {
          justify-content: center;
        }

        .treatment-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        /*
          Stacked full-width blocks at 175px tall took up most of a phone
          screen for three links. As compact left-aligned bars they read as
          navigation rather than billboards, and the whole set fits in view.
        */
        .social-grid {
          gap: 10px;
          grid-template-columns: 1fr;
        }

        .social-card {
          min-height: 0;
          justify-items: start;
          gap: 2px;
          padding: 13px 18px;
          text-align: left;
        }

        .social-card strong {
          font-size: 1.05rem;
        }

        .social-card span {
          font-size: 0.82rem;
        }

        .footer-grid {
          grid-template-columns: 1fr 1fr;
        }

        .footer-grid > :first-child {
          grid-column: 1 / -1;
        }
      }

      @media (max-width: 700px) {
        body {
          padding-bottom: 92px;
        }

        /*
          The topbar is hidden here, not removed. Between the sticky top block
          and the fixed booking bar, a phone was giving up too much of the
          viewport to permanent furniture. Nothing is lost: the address appears
          again in Find Us and in the footer, and the booking link is already
          the primary button in the bar at the bottom.
        */
        .topbar {
          display: none;
        }

        /*
          Anchor offset drops to match — only the header sticks at this width,
          so the 175px used on desktop would leave a large gap above each
          section when jumping from the menu.
        */
        html {
          scroll-padding-top: 88px;
        }

        .container {
          width: min(calc(100% - 28px), var(--page-width));
        }

        .section {
          padding: 68px 0;
        }

        .header-inner {
          min-height: 72px;
        }

        .brand img {
          width: 52px;
          height: 52px;
        }

        .brand strong {
          font-size: 1rem;
        }

        .hero-banner-section {
          padding: 18px 0 34px;
        }

        .hero-banner {
          border-radius: 17px;
        }

        .hero-content {
          padding: 51px 0 75px;
        }

        h1 {
          font-size: clamp(2.45rem, 13vw, 3.9rem);
        }

        .hero-actions {
          display: grid;
        }

        .hero-actions .button {
          width: 100%;
        }

        .booking-strip {
          margin-top: -5px;
        }

        .booking-inner {
          padding: 24px;
          grid-template-columns: 1fr;
          text-align: center;
        }

        .booking-inner .button {
          width: 100%;
        }

        .treatment-grid,
        .gallery-grid,
        .reviews-grid,
        .footer-grid {
          grid-template-columns: 1fr;
        }

        .footer-grid > :first-child {
          grid-column: auto;
        }

        .review-buttons,
        .location-actions {
          display: grid;
        }

        .review-buttons .button,
        .location-actions .button {
          width: 100%;
        }

        .mobile-booking-bar {
          display: grid;
        }
      }


      /* Opening sequence: round FYB logo, then fade away. */
      .opening-loader {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: grid;
        place-items: center;
        min-height: 100vh;
        min-height: 100svh;
        padding: 18px;
        overflow: hidden;
        background: #ffffff;
        opacity: 1;
        visibility: visible;
        transition: opacity 0.6s ease, visibility 0.6s ease;
      }

      .opening-loader.is-leaving {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .opening-logo img {
        display: block;
        width: min(88vw, 510px);
        height: auto;
        border-radius: 50%;
        animation: logo-settle 0.7s ease both;
      }

      @keyframes logo-settle {
        from {
          opacity: 0;
          transform: scale(0.94);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      body.loader-active {
        overflow: hidden;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
        }

        .opening-logo img {
          animation: none;
        }
      }
    </style>
  </head>

  <body class="loader-active">

    <div
      id="opening-loader"
      class="opening-loader"
      aria-hidden="true"
    >
      <div class="opening-logo">
        <img
          src="/images/fyb-logo2.png"
          alt=""
          width="1200"
          height="1200"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
    {/*
      Topbar and header share a sticky wrapper so the whole top block moves as
      one unit. Sticking them separately would mean hardcoding the topbar's
      height into the header's `top` value, which breaks the moment the topbar
      wraps to two lines on a narrow screen.
    */}
    <div class="site-top">
      <div class="topbar">
        <span>Based at Abshot Country Club in Titchfield Common.</span>
        <a
          href={links.treatwell}
          target="_blank"
          rel="noopener noreferrer"
        >
          Book online with Treatwell
        </a>
      </div>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#home" aria-label="Forever Young Beauty home">
          <img
            src="/images/fyb-logo2.png"
            alt="Forever Young Beauty by Layla"
            width="120"
            height="120"
            loading="eager"
          />
          <span class="brand-text">
            <strong>Forever Young Beauty</strong>
            <span class="brand-suffix">by Layla</span>
          </span>
        </a>

        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#treatments">Treatments</a>
          <a href="#results">Results</a>
          <a href="#reviews">Reviews</a>
          <a href="#location">Find us</a>

          <a
            class="button button-treatwell"
            href={links.treatwell}
            target="_blank"
            rel="noopener noreferrer"
          >
            View treatments and book
          </a>
        </nav>

        <button
          class="menu-button"
          id="menu-button"
          type="button"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="mobile-navigation"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M4 7h16M4 12h16M4 17h16"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>

      <nav
        class="mobile-nav"
        id="mobile-navigation"
        aria-label="Mobile navigation"
      >
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#treatments">Treatments</a>
        <a href="#results">Before and after</a>
        <a href="#reviews">Reviews</a>
        <a href="#location">Find us</a>
        <a href="#faq">FAQs</a>

        <a
          href={links.treatwell}
          target="_blank"
          rel="noopener noreferrer"
        >
          View treatments and book
        </a>
      </nav>
      </header>
    </div>

    <main>

      <div id="home"></div>

      <section class="hero-content">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">
              Forever Young Beauty at Abshot Country Club
            </p>

            {/*
              The H1 previously carried no location at all, which left the
              single strongest on-page signal doing nothing for local search.
            */}
            <h1>Advanced beauty, skin and wellness treatments near Fareham</h1>

            <p class="lead">
              Personalised facials, advanced skin treatments, massage,
              waxing, body treatments and aesthetics in a
              calm, welcoming treatment room near Fareham.
            </p>

          </div>

          <div class="hero-photo-wrap">
            <img
              class="hero-photo"
              src="/images/layla-treatment.jpg"
              alt="Layla carrying out a professional facial treatment"
              width="1240"
              height="1240"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </section>

      <section class="section" id="about">
        <div class="container about-grid">

          <div>
            <p class="eyebrow">Personalised care</p>
            <h2>Treatments designed around you</h2>

            <p class="lead">
              Forever Young Beauty by Layla offers facial, massage, waxing,
              body and advanced skin treatments in a calm,
              private setting.
            </p>

            <ul class="benefits">
              <li>Friendly one-to-one appointments with Layla.</li>
              <li>
                A convenient location at Abshot Country Club in Titchfield
                Common.
              </li>
              <li>
                Easy to reach from Locks Heath, Park Gate, Whiteley, Warsash
                and Fareham.
              </li>
              <li>
                Treatment choices and appointment availability through
                Treatwell.
              </li>
              <li>
                WhatsApp support for treatment questions before booking.
              </li>
            </ul>
          </div>
        </div>
      </section>

      <section class="section section-soft" id="treatments">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Treatment menu</p>
            <h2>Explore the treatment collections</h2>

            <p class="lead">
              Choose from personalised facial, skin, massage, beauty, body,
              aesthetic and wellness treatments.
            </p>

            {/*
              Points every pricing, duration and availability question at
              Treatwell, which is what keeps this page from ever being wrong.
            */}
            <p class="treatwell-note">
              For the latest treatment menu, availability and prices, please
              view the live booking menu on Treatwell. Patch tests are free
              where a treatment needs one.
            </p>
          </div>

          <div class="treatment-grid">
            {
              treatments.map((treatment) => (
                <article class="treatment-card">
                  <span class="treatment-category">
                    {treatment.category}
                  </span>

                  <h3>{treatment.title}</h3>
                  <p>{treatment.description}</p>

                  <a
                    class="card-link"
                    href={links.treatwell}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
