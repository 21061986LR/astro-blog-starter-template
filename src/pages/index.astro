        padding: 52px 0 105px;
        color: rgba(255, 255, 255, 0.73);
        background: var(--navy-dark);
      }

      .footer-grid {
        display: grid;
        gap: 38px;
        grid-template-columns: 1.25fr 0.75fr 0.75fr;
      }

      .footer-logo {
        width: 82px;
        height: 82px;
        margin-bottom: 15px;
        object-fit: contain;
        border-radius: 50%;
      }

      .footer-heading {
