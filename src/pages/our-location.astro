---
import SiteMenuBehaviour from "../components/SiteMenuBehaviour.astro";
import { NAV_LINKS, TREATMENT_PAGES, DIRECTIONS_URL, SITE_URL, BOOKING_URL } from "../data/site";
const path = "/our-location/";
const title = "Our Location | Forever Young Beauty by Layla at Abshot Country Club";
const description = "Find Forever Young Beauty by Layla at Abshot Country Club, Little Abshot Road, Titchfield Common, Fareham PO14 4LN. Directions, treatments and booking.";
const canonical = "https://foreveryoungbeautybylayla.co.uk/our-location/";
const booking = BOOKING_URL;
const club = "https://www.abshotcountryclub.com/";
const maps = DIRECTIONS_URL;
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonical,
  about: { "@type": "BeautySalon", "@id": `${SITE_URL}/#salon`, name: "Forever Young Beauty by Layla", url: "https://foreveryoungbeautybylayla.co.uk/", address: { "@type": "PostalAddress", streetAddress: "Abshot Country Club, Little Abshot Road", addressLocality: "Titchfield Common, Fareham", addressRegion: "Hampshire", postalCode: "PO14 4LN", addressCountry: "GB" } }
};
---
<!doctype html>
<html lang="en-GB">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><script type="application/ld+json" set:html={JSON.stringify(schema)} /></head>
<body>
<header class="top"><a class="brand" href="/" aria-label="Forever Young Beauty homepage"><strong>Forever Young Beauty</strong><span>by Layla</span></a><a class="corner-logo" href="/" aria-label="Return to homepage"><img src="/images/fyb-header-logo.svg" alt="Forever Young Beauty logo" width="62" height="62" loading="eager" /></a><details class="menu"><summary aria-label="Open site menu"><span class="hamburger" aria-hidden="true">☰</span></summary><nav aria-label="Site navigation">{NAV_LINKS.map((l) => <a href={l.href} aria-current={l.href === path ? "page" : undefined}>{l.label}</a>)}</nav></details></header>
<main><section class="hero"><div class="inner"><p class="eyebrow">Find us in Titchfield Common, Fareham</p><h1>Our Location at Abshot Country Club</h1><p class="lead">Visit Forever Young Beauty by Layla at Abshot Country Club. Layla runs her own independent beauty business at the country club, with her own treatments and online bookings. Convenient for Fareham, Locks Heath, Park Gate and Whiteley.</p><a class="button" href={booking}>View prices &amp; availability</a></div></section>
<div class="content">
<section><h2>Where to find Layla</h2><p>Forever Young Beauty by Layla is based at Abshot Country Club, Little Abshot Road, Titchfield Common, Fareham, Hampshire PO14 4LN.</p><p>Use the directions link to plan your journey. If you're visiting for the first time, allow a little extra time to find the treatment room.</p><div class="actions"><a class="button" href={maps} target="_blank" rel="noopener noreferrer">Get directions on Google Maps ↗</a><a class="button" href={club} target="_blank" rel="noopener noreferrer">Explore Abshot Country Club ↗</a></div></section>
<section class="venue"><img src="/images/entrance-wide.jpg" alt="Entrance to the venue where Forever Young Beauty by Layla is based" width="900" height="600" loading="lazy"/><div><h2>A beauty studio at Abshot</h2><p>Layla welcomes clients for individual beauty and aesthetic appointments in her treatment space at the country club. The venue's location makes it convenient for visitors from Titchfield Common, Fareham, Locks Heath, Park Gate and surrounding areas.</p><p>For information about the wider venue and its facilities, visit <a href={club} target="_blank" rel="noopener noreferrer">Abshot Country Club's official website</a>.</p></div></section>
<section><h2>Directions from Locks Heath, Whiteley and nearby areas</h2><p>Forever Young Beauty by Layla is an independent business based at Abshot Country Club on Little Abshot Road, Titchfield Common, Hampshire PO14 4LN. If you're travelling from Locks Heath, Park Gate, Whiteley, Sarisbury Green, Warsash, Stubbington, Hill Head or Fareham, use <a href={maps}>Google Maps directions to Layla's own business location</a> for a route from your starting point.</p><p>When planning your first appointment, check your booking confirmation and allow a little extra time to locate Layla's treatment room within the country club. For current services, prices and availability, use her own booking link.</p></section>
<section class="contact"><h2>Ready to visit?</h2><p>Check Layla's current treatment prices and appointment availability online.</p><a class="button" href={booking}>Book with Layla</a></section>
<nav aria-label="Treatments"><h2>Explore treatments</h2><p>Choose a treatment to learn more before booking directly with Layla.</p><div class="links">{TREATMENT_PAGES.map((t) => <a href={t.href}>{t.label} →</a>)}</div></nav>
</div></main>
<footer><a href="/">Forever Young Beauty by Layla</a> · Titchfield Common, Fareham</footer>
<SiteMenuBehaviour />
</body></html>
<style>
/* Keep primary booking actions comfortably tappable on mobile. */
a.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;text-align:center}
@media(max-width:560px){.hero a.button{max-width:100%;width:100%}.menu summary{min-width:48px;min-height:48px;justify-content:center}.menu nav a{min-height:44px;display:flex;align-items:center}}

:root{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#1b3a4c;background:#fff}*{box-sizing:border-box}body{margin:0;line-height:1.7}a{color:#1b3a4c}.top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem max(1rem,calc((100vw - 1050px)/2));background:#1b3a4c;color:white}.top a{color:white;text-decoration:none}.top span{font-weight:700;text-align:center}.top em{font-family:Georgia,serif;color:#d9c79f;font-weight:400}.hero{background:linear-gradient(140deg,#1b3a4c,#31576a);color:white;padding:4.5rem 1.25rem}.inner{max-width:900px;margin:auto;text-align:center}.eyebrow{text-transform:uppercase;letter-spacing:.14em;color:#dfc99b;font-size:.78rem;font-weight:700}h1,h2{font-family:Georgia,serif;line-height:1.2}h1{font-size:clamp(2rem,5vw,3.6rem);margin:.6rem 0 1rem}.lead{font-size:1.14rem;max-width:720px;margin:0 auto 2rem;color:#edf1f3}.button{display:inline-block;background:#b09a6e;color:#172f3b;text-decoration:none;padding:.85rem 1.4rem;border-radius:99px;font-weight:700}.button:hover{background:#dfc99b}.content{max-width:850px;margin:auto;padding:2.5rem 1.25rem}.content section{margin:0 0 2.5rem}.content h2{font-size:1.7rem;margin-bottom:.65rem}.content p{margin-top:0}.content video{width:100%;max-height:520px;background:#102733;border-radius:12px}.contact{background:#eef1f3;border-radius:18px;padding:2rem;margin-top:3rem!important}.contact .button{margin:1rem 0}.links{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:.8rem}.links a{display:block;background:#eef1f3;padding:1rem;border-radius:12px;text-decoration:none;font-weight:600}footer{padding:2rem 1rem;text-align:center;background:#1b3a4c;color:white}footer a{color:white}@media(max-width:560px){.top{font-size:.78rem}.top span{max-width:150px}.hero{padding:3rem 1rem}}
.top{position:relative;display:flex;align-items:center;justify-content:center;min-height:92px;padding:12px 78px 12px 16px}.top .brand{display:flex;flex-direction:column;align-items:center;text-align:center;line-height:1.3;text-decoration:none;color:#fff;max-width:100%}.brand strong{font-size:clamp(.95rem,3.4vw,1.3rem);white-space:nowrap}.brand span{font-family:Georgia,serif;color:#d9c79f;font-size:.96rem;margin-top:3px}.menu{position:absolute;right:14px;top:50%;transform:translateY(-50%);z-index:20}.menu summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:5px;color:#fff;padding:8px}.menu summary::-webkit-details-marker{display:none}.hamburger{font-size:1.55rem;line-height:1}.menu-label{font-size:.8rem}.menu nav{position:absolute;right:0;top:calc(100% + 9px);background:#fff;border:1px solid #d7dfe3;border-radius:12px;box-shadow:0 8px 22px #10273330;min-width:210px;display:flex;flex-direction:column;padding:8px}.menu nav a{color:#1b3a4c;text-decoration:none;padding:9px 12px;border-radius:7px}.menu nav a:hover,.menu nav a:focus-visible{background:#eef1f3}@media(max-width:560px){.top{padding-right:65px}.menu-label{display:none}.menu{right:9px}.brand strong{font-size:clamp(.84rem,3.8vw,1.05rem)}}.corner-logo{position:absolute;left:14px;right:auto;top:50%;transform:translateY(-50%);width:54px;height:54px;border-radius:50%;background:#fff;display:grid;place-items:center;overflow:hidden;padding:5px;box-shadow:0 1px 5px #0002}.corner-logo img{width:100%;height:100%;object-fit:contain}.top{padding-left:85px;padding-right:75px}.menu{right:13px}@media(max-width:560px){.corner-logo{left:8px;right:auto;width:43px;height:43px;padding:4px}.top{padding-left:64px;padding-right:55px}.menu{right:6px}.top .brand{margin-left:0}}.menu nav{position:fixed;right:8px;top:72px;width:min(270px,calc(100vw - 16px));min-width:0;max-height:calc(100dvh - 85px);overflow-y:auto;box-sizing:border-box}.menu nav a{font-size:16px;line-height:1.3;white-space:normal}.corner-logo{width:62px;height:62px;padding:2px}.corner-logo img{object-fit:cover}@media(max-width:560px){.corner-logo{width:54px;height:54px;padding:2px}}
/* Our Location only: directions buttons and the venue photo. */
.actions{display:flex;flex-wrap:wrap;gap:.75rem;align-items:center;margin-top:1.25rem}@media(max-width:560px){.actions{flex-direction:column;align-items:stretch}.actions .button{width:100%}}.venue{display:grid;grid-template-columns:1fr 1fr;gap:1.75rem;align-items:center}.venue img{width:100%;height:auto;border-radius:14px;object-fit:cover;display:block}.venue h2{margin-top:0}@media(max-width:640px){.venue{grid-template-columns:1fr}}
</style>
