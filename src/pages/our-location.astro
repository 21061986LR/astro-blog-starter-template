---
import MenuAutoClose from "../components/MenuAutoClose.astro";
import { NAV_LINKS, TREATMENT_PAGES, DIRECTIONS_URL, SITE_URL } from "../data/site";
const path = "/our-location/";
const title = "Our Location | Forever Young Beauty by Layla at Abshot Country Club";
const description = "Find Forever Young Beauty by Layla at Abshot Country Club, Little Abshot Road, Titchfield Common, Fareham PO14 4LN. Directions, treatments and booking.";
const canonical = "https://foreveryoungbeautybylayla.co.uk/our-location/";
const booking = "https://laylaradestock.mytreatwell.co.uk/";
const club = "https://www.abshotcountryclub.com/";
const maps = DIRECTIONS_URL;
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonical,
  about: { "@type": "BeautySalon", "@id": `${SITE_URL}/#salon`, name: "Forever Young Beauty by Layla", url: "https://foreveryoungbeautybylayla.co.uk/", address: { "@type": "PostalAddress", streetAddress: "Abshot Country Club, Little Abshot Road", addressLocality: "Titchfield Common, Fareham", addressRegion: "Hampshire", postalCode: "PO14 4LN", addressCountry: "GB" } }
};
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
<header class="site-header">
<a class="logo" href="/" aria-label="Forever Young Beauty homepage"><img src="/images/fyb-header-logo.svg" alt="Forever Young Beauty by Layla" width="66" height="66" /></a>
<details class="menu"><summary aria-label="Open site menu"><span aria-hidden="true">☰</span> Menu</summary><nav aria-label="Site navigation">{NAV_LINKS.map((l) => <a href={l.href} aria-current={l.href === path ? "page" : undefined}>{l.label}</a>)}</nav></details>
</header>
<main>
<section class="hero"><div class="wrap"><p class="eyebrow">Find us in Titchfield Common, Fareham</p><h1>Our Location at Abshot Country Club</h1><p>Visit Forever Young Beauty by Layla at Abshot Country Club. Layla runs her own independent beauty business at the country club, with her own treatments and online bookings. Convenient for Fareham, Locks Heath, Park Gate and Whiteley.</p><a class="button" href={booking}>View prices &amp; availability</a></div></section>
<div class="wrap content">
<section><h2>Where to find Layla</h2><p>Forever Young Beauty by Layla is based at <strong>Abshot Country Club</strong>, Little Abshot Road, Titchfield Common, Fareham, Hampshire <strong>PO14 4LN</strong>.</p><p>Use the directions link to plan your journey. If you're visiting for the first time, allow a little extra time to find the treatment room.</p><div class="actions"><a class="button" href={maps} target="_blank" rel="noopener noreferrer">Get directions on Google Maps ↗</a><a class="secondary" href={club} target="_blank" rel="noopener noreferrer">Explore Abshot Country Club ↗</a></div></section>
<section class="venue"><img src="/images/entrance-wide.jpg" alt="Entrance to the venue where Forever Young Beauty by Layla is based" width="900" height="600" loading="lazy"/><div><h2>A beauty studio at Abshot</h2><p>Layla welcomes clients for individual beauty and aesthetic appointments in her treatment space at the country club. The venue's location makes it convenient for visitors from Titchfield Common, Fareham, Locks Heath, Park Gate and surrounding areas.</p><p>For information about the wider venue and its facilities, visit <a href={club} target="_blank" rel="noopener noreferrer">Abshot Country Club's official website</a>.</p></div></section>
<section><h2>Explore treatments</h2><p>Choose a treatment to learn more before booking directly with Layla.</p><div class="treatments">{TREATMENT_PAGES.map((p) => <a href={p.href}>{p.label} →</a>)}</div></section>
<section class="book"><h2>Ready to visit?</h2><p>Check Layla's current treatment prices and appointment availability online.</p><a class="button" href={booking}>Book with Layla</a></section>
</div>
</main>
<footer><p>Forever Young Beauty by Layla · Abshot Country Club · Titchfield Common · Fareham PO14 4LN</p><p><a href="/">Home</a> · <a href={club} target="_blank" rel="noopener noreferrer">Abshot Country Club</a> · <a href={booking}>Book online</a></p></footer>
<MenuAutoClose />
</body>
</html>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;font-family:Arial,Helvetica,sans-serif;color:#21333c;background:#fffdf9;line-height:1.65}:global(a){color:#244d60}:global(a:focus-visible){outline:3px solid #b68d4c;outline-offset:3px}
.site-header{min-height:88px;display:flex;align-items:center;justify-content:space-between;padding:10px max(5%,20px);background:#fff;position:relative;z-index:2;border-bottom:1px solid #e9e2d6}.logo img{display:block;width:66px;height:66px;object-fit:contain}.menu{position:relative}.menu summary{list-style:none;cursor:pointer;border-radius:9px;background:#1b3a4c;color:white;padding:10px 16px;font-size:18px;font-weight:600}.menu summary::-webkit-details-marker{display:none}.menu nav{position:absolute;right:0;top:calc(100% + 8px);min-width:235px;background:#fff;box-shadow:0 8px 28px #0002;border:1px solid #e4e0d9;border-radius:12px;padding:8px;display:flex;flex-direction:column}.menu nav a{padding:9px 12px;text-decoration:none;border-radius:7px}.menu nav a:hover{background:#f4f0e9}.wrap{width:min(1080px,90%);margin:auto}.hero{padding:85px 0;background:linear-gradient(115deg,#f3ebdd,#fffaf3)}.eyebrow{color:#886a3d;text-transform:uppercase;letter-spacing:.14em;font-size:.82rem;font-weight:700}.hero h1{font-size:clamp(2rem,5vw,3.5rem);line-height:1.16;max-width:780px;margin:.35em 0}.hero p:not(.eyebrow){max-width:690px;font-size:1.1rem}.button{display:inline-block;background:#1b3a4c;color:white;text-decoration:none;border-radius:8px;padding:12px 22px;font-weight:700;margin-top:10px}.button:hover{background:#315d71}.content section{margin:55px 0}.content h2{font-size:clamp(1.4rem,3vw,2rem);line-height:1.25}.actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center}.secondary{display:inline-block;padding:12px 8px;margin-top:10px}.venue{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center}.venue img{width:100%;height:auto;border-radius:14px;object-fit:cover}.treatments{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.treatments a{display:block;background:#f5f0e8;border-radius:10px;padding:18px;text-decoration:none;font-weight:700}.book{text-align:center;padding:30px;background:#f5f0e8;border-radius:14px}footer{text-align:center;background:#1b3a4c;color:white;padding:30px 18px}footer a{color:#fff}@media(max-width:640px){.hero{padding:50px 0}.venue,.treatments{grid-template-columns:1fr}.site-header{padding:8px 16px}.menu nav{max-width:calc(100vw - 24px)}}
</style>