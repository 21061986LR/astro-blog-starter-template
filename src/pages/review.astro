---
// Short link for clients: foreveryoungbeautybylayla.co.uk/review
// Sends them straight to the box for writing a Google review.
import { WRITE_REVIEW_URL } from "../data/site";
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0; url=${WRITE_REVIEW_URL}`} />
    <title>Leave a Google review | Forever Young Beauty by Layla</title>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; background: #1b3a4c; color: #fff; text-align: center; }
      h1 { font-family: Georgia, serif; font-weight: 500; font-size: 1.8rem; margin: 0 0 1rem; }
      a { display: inline-block; background: #b09a6e; color: #142c3a; padding: .85rem 1.4rem; border-radius: 99px; font-weight: 700; text-decoration: none; }
    </style>
  </head>
  <body>
    <main>
      <h1>Thank you for leaving Layla a review</h1>
      <p><a href={WRITE_REVIEW_URL}>Open Google reviews</a></p>
    </main>
  </body>
</html>
